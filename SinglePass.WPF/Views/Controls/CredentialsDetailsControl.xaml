<UserControl
    x:Class="SinglePass.WPF.Views.Controls.CredentialsDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <conv:PasswordMaskConverter x:Key="PasswordMaskConverter" />
        <Style x:Key="DetailGlyphStyle" BasedOn="{StaticResource WorkspaceIconStyle}" TargetType="TextBlock">
            <Setter Property="Width" Value="20" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="DetailActionStyle" BasedOn="{StaticResource WorkspaceIconButtonStyle}" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>
    <Border Padding="0" Background="{DynamicResource WorkspaceDetail}" Style="{StaticResource WorkspacePanelStyle}">
        <Grid>
            <Border Background="{DynamicResource WorkspaceGlow}" CornerRadius="13" IsHitTestVisible="False" />
            <Grid Margin="22,20,20,16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCredentialVM}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,19">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource DetailActionStyle}" Command="{Binding EditCommand}"
                                AutomationProperties.Name="{x:Static properties:Resources.Edit}" ToolTip="{x:Static properties:Resources.Edit}">
                            <TextBlock FontSize="19" Style="{StaticResource WorkspaceIconStyle}" Text="&#xE70F;" />
                        </Button>
                        <Button Style="{StaticResource DetailActionStyle}" Command="{Binding DeleteCommand}"
                                AutomationProperties.Name="{x:Static properties:Resources.Delete}" ToolTip="{x:Static properties:Resources.Delete}">
                            <TextBlock FontSize="19" Style="{StaticResource WorkspaceIconStyle}" Text="&#xE74D;" />
                        </Button>
                    </StackPanel>
                    <ContentControl DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,12,0" Padding="7"
                                    Content="{Binding SelectedCredentialVM.FavIcon32}" Style="{StaticResource WorkspaceCredentialIconStyle}" />
                    <TextBlock VerticalAlignment="Center" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectedCredentialVM.NameFieldVM.Value}" ToolTip="{Binding SelectedCredentialVM.NameFieldVM.Value}" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" Margin="0,0,-10,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <Label Target="{Binding ElementName=LoginTextBox}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DetailGlyphStyle}" Text="&#xE77B;" />
                                <TextBlock Text="{x:Static properties:Resources.Login}" />
                            </StackPanel>
                        </Label>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource DetailActionStyle}"
                                    Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.LoginFieldVM.Value}"
                                    AutomationProperties.Name="{x:Static properties:Resources.CopyLogin}" ToolTip="{x:Static properties:Resources.CopyLogin}">
                                <TextBlock Style="{StaticResource WorkspaceIconStyle}" Text="&#xE8C8;" />
                            </Button>
                            <TextBox x:Name="LoginTextBox" IsReadOnly="True" AutomationProperties.Name="{x:Static properties:Resources.Login}"
                                     Text="{Binding SelectedCredentialVM.LoginFieldVM.Value, Mode=OneWay}" />
                        </DockPanel>
                        <StackPanel Margin="0,16,0,6" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DetailGlyphStyle}" Text="&#xE8D7;" />
                            <TextBlock FontWeight="Medium" Text="{x:Static properties:Resources.Password}" />
                        </StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ToggleButton Margin="8,0,0,0" Style="{StaticResource WorkspaceIconToggleStyle}" IsChecked="{Binding IsPasswordVisible}"
                                              AutomationProperties.Name="{x:Static properties:Resources.ShowHidePassword}" ToolTip="{x:Static properties:Resources.ShowHidePassword}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WorkspaceIconStyle}">
                                                <Setter Property="Text" Value="&#xE890;" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                        <Setter Property="Text" Value="&#xED1A;" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToggleButton>
                                <Button Style="{StaticResource DetailActionStyle}"
                                        Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.PasswordFieldVM.Value}"
                                        AutomationProperties.Name="{x:Static properties:Resources.CopyPassword}" ToolTip="{x:Static properties:Resources.CopyPassword}">
                                    <TextBlock Style="{StaticResource WorkspaceIconStyle}" Text="&#xE8C8;" />
                                </Button>
                            </StackPanel>
                            <Grid>
                                <TextBox IsReadOnly="True" AutomationProperties.Name="{x:Static properties:Resources.Password}"
                                         Text="{Binding SelectedCredentialVM.PasswordFieldVM.Value, Mode=OneWay}"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBox x:Name="MaskedPassword" Focusable="False" IsHitTestVisible="False" IsReadOnly="True"
                                         AutomationProperties.Name="{x:Static properties:Resources.Password}"
                                         Text="{Binding SelectedCredentialVM.PasswordFieldVM.Value.Length, Mode=OneWay, Converter={StaticResource PasswordMaskConverter}}"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </DockPanel>
                        <Label Margin="0,16,0,0" Target="{Binding ElementName=WebsiteTextBox}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DetailGlyphStyle}" Text="&#xE71B;" />
                                <TextBlock Text="{x:Static properties:Resources.Website}" />
                            </StackPanel>
                        </Label>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource DetailActionStyle}"
                                    Command="{Binding OpenInBrowserCommand}"
                                    AutomationProperties.Name="{x:Static properties:Resources.OpenInBrowser}" ToolTip="{x:Static properties:Resources.OpenInBrowser}">
                                <TextBlock Style="{StaticResource WorkspaceIconStyle}" Text="&#xE8A7;" />
                            </Button>
                            <TextBox x:Name="WebsiteTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                     AutomationProperties.Name="{x:Static properties:Resources.Website}"
                                     Text="{Binding SelectedCredentialVM.SiteFieldVM.Value, Mode=OneWay}" />
                        </DockPanel>
                        <Label Margin="0,16,0,0" Target="{Binding ElementName=OtherTextBox}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DetailGlyphStyle}" Text="&#xE70B;" />
                                <TextBlock Text="{x:Static properties:Resources.Other}" />
                            </StackPanel>
                        </Label>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding OpenOtherInBrowserCommand}" CommandParameter="{Binding SelectedCredentialVM.OtherFieldVM.Value}"
                                    AutomationProperties.Name="{x:Static properties:Resources.OpenInBrowser}" ToolTip="{x:Static properties:Resources.OpenInBrowser}">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource DetailActionStyle}" TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Style="{StaticResource WorkspaceIconStyle}" Text="&#xE8A7;" />
                            </Button>
                            <TextBox x:Name="OtherTextBox" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="{x:Static properties:Resources.Other}"
                                     Text="{Binding SelectedCredentialVM.OtherFieldVM.Value, Mode=OneWay}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SelectedCredentialVM.AdditionalFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,12,0,0">
                                        <Label Content="{Binding Name}" Target="{Binding ElementName=FieldValue}" />
                                        <TextBox x:Name="FieldValue" IsReadOnly="True" TextWrapping="Wrap" Text="{Binding Value, Mode=OneWay}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Height="1" Margin="0,22,0,16" Background="{DynamicResource WorkspaceFieldStroke}" />
                        <DockPanel TextElement.Foreground="{DynamicResource WorkspaceMuted}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailGlyphStyle}" Text="&#xE787;" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding SelectedCredentialVM.LastModifiedTime, StringFormat={x:Static properties:Resources.ModifiedFormatted}}" />
                        </DockPanel>
                        <DockPanel Margin="0,6,0,0" TextElement.Foreground="{DynamicResource WorkspaceMuted}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource DetailGlyphStyle}" Text="&#xE787;" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding SelectedCredentialVM.CreationTime, StringFormat={x:Static properties:Resources.CreatedFormatted}}" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>

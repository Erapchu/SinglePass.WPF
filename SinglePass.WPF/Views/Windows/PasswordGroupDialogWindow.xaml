<Window
    x:Class="SinglePass.WPF.Views.Windows.PasswordGroupDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization"
    Title="{Binding [AddPasswordGroup], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
    Width="380"
    FocusManager.FocusedElement="{Binding ElementName=GroupNameTextBox}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16">
        <Label Padding="0,0,0,6" Target="{Binding ElementName=GroupNameTextBox}"
               Content="{Binding [Name], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        <TextBox x:Name="GroupNameTextBox" MaxLength="100" TextChanged="GroupName_TextChanged" />
        <Label Margin="0,10,0,0" Padding="0,0,0,6" Target="{Binding ElementName=IconList}"
               Content="{Binding [GroupIcon], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        <ListBox x:Name="IconList" HorizontalAlignment="Left"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="{Binding [GroupIcon], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" KeyboardNavigation.DirectionalNavigation="Contained" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Width" Value="40" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Margin" Value="0,0,4,4" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent"
                                        BorderThickness="1" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource SymbolText}" FontSize="20" Text="{Binding Glyph}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="SaveGroupButton" Margin="0,0,8,0" Click="SaveGroup_Click" IsDefault="True" IsEnabled="False"
                    Content="{Binding [Save], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button IsCancel="True" Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</Window>

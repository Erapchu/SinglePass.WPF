<UserControl
    x:Class="Erapkey.Desktop.Views.Controls.TrashControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:entries="clr-namespace:Erapkey.Desktop.Views.Controls.Entries"
    xmlns:evm="clr-namespace:Erapkey.Desktop.ViewModels.Entries"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <!-- Icon of an entry, as in the list of entries. -->
        <DataTemplate DataType="{x:Type evm:CredentialDataViewModel}">
            <TextBlock Style="{StaticResource SymbolText}" FontSize="18" Text="{Binding Glyph}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type evm:LoginViewModel}">
            <Image Source="{Binding DataContext.FavIcon, RelativeSource={RelativeSource AncestorType=ContentControl}, TargetNullValue={StaticResource DefaultFavIcon}}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type evm:CardViewModel}">
            <entries:CardBrandIcon Width="32" Height="20" Brand="{Binding Brand}" />
        </DataTemplate>
        <!-- Text-only button: "Restore all" and "Empty trash". -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Margin="8" Style="{StaticResource Card}" Padding="16,16,16,8" VerticalAlignment="Top">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding CountText}"
                               Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibility}}" />
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74D;" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                               AutomationProperties.HeadingLevel="Level2"
                               Text="{Binding [RecentlyDeleted], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                </DockPanel>
                <TextBlock Margin="0,10,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Description}" />

                <TextBlock Margin="0,16,0,16" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding [TrashEmpty], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,12">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Margin="6,0,0,0" Style="{StaticResource IconButton}"
                                            Background="Transparent" BorderThickness="0"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding [DeleteForever], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                            ToolTip="{Binding [DeleteForever], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                        <TextBlock Style="{StaticResource SymbolText}" FontSize="14" Text="&#xE74D;" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" Style="{StaticResource IconButton}"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding [Restore], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                            ToolTip="{Binding [Restore], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                        <TextBlock Style="{StaticResource SymbolText}" FontSize="14" Text="&#xE7A7;" />
                                    </Button>
                                    <ContentControl Width="32" Height="24" Margin="0,0,12,0" VerticalAlignment="Center"
                                                    Focusable="False" IsTabStop="False"
                                                    DataContext="{Binding Credential}" Content="{Binding Data}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}" ToolTip="{Binding Name}" />
                                        <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Details}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="0,8,0,0"
                        Visibility="{Binding HasItems, Converter={StaticResource BooleanToVisibility}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Margin="0,0,-8,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontWeight="SemiBold"
                                Command="{Binding EmptyTrashCommand}"
                                Content="{Binding [EmptyTrash], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <Button HorizontalAlignment="Left" Style="{StaticResource TextButton}" Margin="-8,0,0,0"
                                Command="{Binding RestoreAllCommand}"
                                Content="{Binding [RestoreAll], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

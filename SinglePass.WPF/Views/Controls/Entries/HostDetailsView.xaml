<UserControl
    x:Class="SinglePass.WPF.Views.Controls.Entries.HostDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:ctl="clr-namespace:SinglePass.WPF.Views.Controls"
    xmlns:evm="clr-namespace:SinglePass.WPF.ViewModels.Entries"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core"
    d:DataContext="{d:DesignInstance Type=evm:HostViewModel}"
    mc:Ignorable="d"
    IsTabStop="False" Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EntryResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:SshKeyLinkConverter x:Key="SshKeyLinkConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Read-only view of an SSH host. DataContext: HostViewModel. -->
    <StackPanel>
        <StackPanel Visibility="{Binding HasHostname, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label Padding="0,0,0,6" Content="{Binding [Hostname], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=HostnameTextBox}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                        Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                        CommandParameter="{Binding Hostname}"
                        AutomationProperties.Name="{Binding [CopyHostname], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyHostname], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                </Button>
                <TextBox x:Name="HostnameTextBox" IsReadOnly="True" Text="{Binding Hostname, Mode=OneWay}" />
            </DockPanel>
        </StackPanel>
        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Port], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PortTextBox}" />
        <TextBox x:Name="PortTextBox" IsReadOnly="True" Text="{Binding Port, Mode=OneWay}" />
        <StackPanel Visibility="{Binding HasUsername, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Username], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=UsernameTextBox}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                        Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                        CommandParameter="{Binding Username}"
                        AutomationProperties.Name="{Binding [CopyUsername], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyUsername], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                </Button>
                <TextBox x:Name="UsernameTextBox" IsReadOnly="True" Text="{Binding Username, Mode=OneWay}" />
            </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding HasSshKey, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="0,12,0,6" Text="{Binding [SshKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <ContentControl Focusable="False" IsTabStop="False">
                <ContentControl.Content>
                    <MultiBinding Converter="{StaticResource SshKeyLinkConverter}">
                        <Binding Path="SshKeyId" />
                        <Binding Path="DataContext.SshKeyOptions" RelativeSource="{RelativeSource AncestorType=ctl:CredentialsDetailsControl}" />
                    </MultiBinding>
                </ContentControl.Content>
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16"
                                       Style="{StaticResource SymbolText}" Text="&#xE756;" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="KeyName" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding KeyType}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KeyType}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter TargetName="KeyName" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>
        <Button Margin="0,16,0,0" HorizontalAlignment="Left"
                Command="{Binding DataContext.CopySshCommandCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding HasHostname}"
                ToolTip="{Binding [CopySshCommandHint], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding [CopySshCommand], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>

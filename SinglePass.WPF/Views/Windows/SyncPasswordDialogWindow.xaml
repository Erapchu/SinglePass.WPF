<Window
    x:Class="SinglePass.WPF.Views.Windows.SyncPasswordDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization"
    Title="{Binding [InputPasswordOfFile], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
    Width="400"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <StackPanel Margin="24">
        <Label Padding="0,0,0,6" Content="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PasswordInput}" />
        <PasswordBox FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}" x:Name="PasswordInput" PasswordChanged="PasswordInput_Changed" />
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                x:Name="AcceptButton"
                Margin="0,0,8,0"
                Click="Accept_Click"
                Content="{Binding [OK], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                IsDefault="True"
                IsEnabled="False"
                Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

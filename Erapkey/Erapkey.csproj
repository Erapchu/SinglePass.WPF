<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\pass-man.ico</ApplicationIcon>
	<ResolveComReferenceSilent>True</ResolveComReferenceSilent>
    <PublishReadyToRun>True</PublishReadyToRun>
    <PublishSingleFile>True</PublishSingleFile>
	<RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--Custom Main runs Velopack hooks before WPF starts-->
    <StartupObject>Erapkey.Program</StartupObject>
      
	<!--ReadyToRun uses Composite mode by default https://github.com/dotnet/wpf/issues/7282-->
	<!--Composite image crashes the app https://github.com/dotnet/runtime/issues/65879-->
	<!--Track: https://github.com/dotnet/sdk/pull/25963-->
	<PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\pass-man.ico" />
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="UIAutomationClient">
      <WrapperTool>tlbimp</WrapperTool>
      <VersionMinor>0</VersionMinor>
      <VersionMajor>1</VersionMajor>
      <Guid>944de083-8fb8-45cf-bcb7-c477acb2f897</Guid>
      <Lcid>0</Lcid>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncKeyedLock" Version="8.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.161" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.91" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NHotkey.Wpf" Version="4.0.0" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.3.0" />
    <PackageReference Include="Unidecode.NET" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erapkey.Core\Erapkey.Core.csproj" />
    <ProjectReference Include="..\Erapkey.Language\Erapkey.Language.csproj" />
    <ProjectReference Include="..\Erapkey.FavIcons.Application\Erapkey.FavIcons.Application.csproj" />
    <ProjectReference Include="..\Erapkey.FavIcons.Repository\Erapkey.FavIcons.Repository.csproj" />
    <!-- Built (and restored) with the application, but not referenced: the browser starts it, see docs/browser-extension.md. -->
    <ProjectReference Include="..\Erapkey.NativeHost\Erapkey.NativeHost.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <PropertyGroup>
    <NativeHostProject>$(MSBuildThisFileDirectory)..\Erapkey.NativeHost\Erapkey.NativeHost.csproj</NativeHostProject>
    <NativeHostOutput>$(MSBuildThisFileDirectory)..\Erapkey.NativeHost\bin\$(Configuration)\win-x64\</NativeHostOutput>
    <!-- The native host is a framework-dependent executable next to a self-contained one; neither loads the other. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <!-- BrowserPipeServer accepts only the native host from the application folder: put it there in every build. -->
  <Target Name="CopyNativeHost" AfterTargets="Build">
    <ItemGroup>
      <NativeHostFiles Include="$(NativeHostOutput)Erapkey.NativeHost.exe;$(NativeHostOutput)Erapkey.NativeHost.dll;$(NativeHostOutput)Erapkey.NativeHost.runtimeconfig.json;$(NativeHostOutput)Erapkey.NativeHost.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeHostFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- A release gets the Native AOT build: one exe that needs no runtime. -->
  <Target Name="PublishNativeHost" AfterTargets="Publish">
    <MSBuild Projects="$(NativeHostProject)" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;PublishDir=$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))" />
    <Delete Files="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))Erapkey.NativeHost.pdb" />
  </Target>

  <ItemGroup>
    <Resource Include="Resources\CardShadow.png" />
    <Resource Include="Resources\pass-man.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Update="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="settings.secrets.json" Condition="Exists('settings.secrets.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

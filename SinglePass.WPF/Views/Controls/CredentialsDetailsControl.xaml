<UserControl
    x:Class="SinglePass.WPF.Views.Controls.CredentialsDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <conv:BooleanTFConverter x:Key="InverseBooleanConverter" TrueValue="False" FalseValue="True" />
        <DataTemplate x:Key="GroupOptionTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" FontSize="14"
                           Style="{StaticResource SymbolText}" Text="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Name}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                    <Setter Property="Text" Value="{Binding [NoPasswordGroup], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding SelectedCredentialVM}" Value="{x:Null}" />
                            <Condition Binding="{Binding DraftCredential}" Value="{x:Null}" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button Margin="4,0" Padding="6,4" Command="{Binding EditCommand}"
                            AutomationProperties.Name="{Binding [Edit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [Edit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE70F;" />
                    </Button>
                    <Button Padding="6,4" Command="{Binding DeleteCommand}"
                            AutomationProperties.Name="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <Image DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,8,0">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{Binding SelectedCredentialVM.FavIcon, TargetNullValue={StaticResource DefaultFavIcon}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                    <Setter Property="Source" Value="{StaticResource DefaultFavIcon}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedCredentialVM.NameFieldVM.Value}"
                           Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <TextBox x:Name="NameEditBox" MaxLength="200" VerticalAlignment="Center"
                         AutomationProperties.Name="{Binding [Name], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                         Text="{Binding DraftCredential.NameFieldVM.Value, UpdateSourceTrigger=PropertyChanged}"
                         IsVisibleChanged="NameEditBox_IsVisibleChanged"
                         IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBooleanConverter}}"
                         Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel Margin="0,0,4,0">
                    <Label Padding="0,0,0,6" Content="{Binding [Login], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=LoginTextBox}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                                Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.LoginFieldVM.Value}"
                                AutomationProperties.Name="{Binding [CopyLogin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyLogin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                        </Button>
                        <TextBox x:Name="LoginTextBox" IsReadOnly="True" Text="{Binding SelectedCredentialVM.LoginFieldVM.Value, Mode=OneWay}" />
                    </DockPanel>
                    <TextBlock Margin="0,12,0,6" Text="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Margin="4,0,0,0" Padding="6,4" IsChecked="{Binding IsPasswordVisible}"
                                          AutomationProperties.Name="{Binding [ShowHidePassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHidePassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                                            <Setter Property="Text" Value="&#xE890;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter Property="Text" Value="&#xED1A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ToggleButton>
                            <Button Margin="4,0,0,0" Padding="6,4"
                                    Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.PasswordFieldVM.Value}"
                                    AutomationProperties.Name="{Binding [CopyPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                            </Button>
                        </StackPanel>
                        <Grid>
                            <TextBox IsReadOnly="True" AutomationProperties.Name="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                     FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                                     Text="{Binding SelectedCredentialVM.PasswordFieldVM.Value, Mode=OneWay}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <PasswordBox FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}" x:Name="PasswordFieldBox" Focusable="False" IsHitTestVisible="False"
                                         AutomationProperties.Name="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                    <StackPanel x:Name="TotpDisplay" Margin="0,12,0,0"
                                DataContext="{Binding SelectedCredentialVM.Totp}"
                                DataContextChanged="TotpDisplay_DataContextChanged"
                                Loaded="TotpDisplay_Loaded"
                                IsVisibleChanged="TotpDisplay_IsVisibleChanged" Unloaded="TotpDisplay_Unloaded">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,6"
                                   Text="{Binding [TotpCode], Source={x:Static loc:LocalizationManager.Instance}}" />
                        <DockPanel>
                            <Button x:Name="CopyTotpButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                                    Command="{Binding DataContext.CopyTotpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.Name="{Binding [CopyTotp], Source={x:Static loc:LocalizationManager.Instance}}"
                                    ToolTip="{Binding [CopyTotp], Source={x:Static loc:LocalizationManager.Instance}}">
                                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TotpCode" FontFamily="Consolas"
                                           FontSize="{StaticResource PasswordFontSize}" VerticalAlignment="Center" />
                                <Grid x:Name="TotpCountdown" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{Binding Stroke, ElementName=TotpProgressArc}" StrokeThickness="2" Opacity="0.2" />
                                    <Path x:Name="TotpProgressArc" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Website], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=WebsiteLink}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Hyperlink x:Name="WebsiteLink" Command="{Binding OpenInBrowserCommand}"
                                   CommandParameter="{Binding SelectedCredentialVM.Website.Address}">
                            <Hyperlink.Style>
                                <Style TargetType="Hyperlink">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="TextDecorations" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsEnabled" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </MultiTrigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Hyperlink.Style>
                            <Run Text="{Binding SelectedCredentialVM.Website.Prefix, Mode=OneWay}" /><Run Text="{Binding SelectedCredentialVM.Website.Host, Mode=OneWay}"
                                 Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Run Text="{Binding SelectedCredentialVM.Website.Suffix, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Other], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=OtherTextBox}" />
                    <TextBox x:Name="OtherTextBox" IsReadOnly="True" TextWrapping="Wrap"
                             Text="{Binding SelectedCredentialVM.OtherFieldVM.Value, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{Binding SelectedCredentialVM.AdditionalFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <Label Padding="0,0,0,6" Content="{Binding Name}" Target="{Binding ElementName=FieldValue}" />
                                    <TextBox x:Name="FieldValue" IsReadOnly="True" Text="{Binding Value, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Label DockPanel.Dock="Left" Padding="0,0,8,0" VerticalAlignment="Center"
                               Content="{Binding [PasswordGroupLabel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <ContentControl Content="{Binding CurrentGroup}" ContentTemplate="{StaticResource GroupOptionTemplate}"
                                        VerticalAlignment="Center" Focusable="False" />
                    </DockPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Mode="OneWay">
                                <MultiBinding.Converter>
                                    <conv:LocalizedFormatConverter />
                                </MultiBinding.Converter>
                                <Binding Path="[ModifiedFormatted]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                <Binding Path="SelectedCredentialVM.LastModifiedTime" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Mode="OneWay">
                                <MultiBinding.Converter>
                                    <conv:LocalizedFormatConverter />
                                </MultiBinding.Converter>
                                <Binding Path="[CreatedFormatted]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                <Binding Path="SelectedCredentialVM.CreationTime" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="EditScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBooleanConverter}}"
                          Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="0,0,4,0">
                    <Label Padding="0,0,0,6" Content="{Binding [Login], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=LoginEditBox}" />
                    <TextBox x:Name="LoginEditBox" MaxLength="200"
                             Text="{Binding DraftCredential.LoginFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PasswordEditBox}" />
                    <TextBox x:Name="PasswordEditBox" MaxLength="200"
                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             Text="{Binding DraftCredential.PasswordFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Website], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=WebsiteEditBox}" />
                    <TextBox x:Name="WebsiteEditBox" MaxLength="5000" TextWrapping="Wrap"
                             Text="{Binding DraftCredential.SiteFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Other], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=OtherEditBox}" />
                    <TextBox x:Name="OtherEditBox" AcceptsReturn="True" MaxLength="5000" TextWrapping="Wrap"
                             Text="{Binding DraftCredential.OtherFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Target="{Binding ElementName=TotpSetupBox}"
                           Content="{Binding [TotpSetup], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Click="PasteTotpQr_Click"
                                IsEnabled="{Binding DraftCredential.RemoveTotp, Converter={StaticResource InverseBooleanConverter}}"
                                Content="{Binding [PasteTotpQr], Source={x:Static loc:LocalizationManager.Instance}}" />
                        <PasswordBox x:Name="TotpSetupBox" MaxLength="4096"
                                 DataContext="{Binding DraftCredential}" DataContextChanged="TotpSetupBox_DataContextChanged"
                                 PasswordChanged="TotpSetupBox_PasswordChanged"
                                 IsEnabled="{Binding RemoveTotp, Converter={StaticResource InverseBooleanConverter}}" />
                    </DockPanel>
                    <TextBlock x:Name="TotpQrStatus" Margin="0,6,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <CheckBox Margin="0,6,0,0" IsChecked="{Binding DraftCredential.RemoveTotp}"
                              Content="{Binding [RemoveTotp], Source={x:Static loc:LocalizationManager.Instance}}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DraftCredential.Totp}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                               Visibility="{Binding DraftCredential.HasInvalidTotp, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Text="{Binding [InvalidTotp], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <ItemsControl ItemsSource="{Binding DraftCredential.AdditionalFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <Label Padding="0,0,0,6" Content="{Binding Name}" Target="{Binding ElementName=FieldEditBox}" />
                                    <TextBox x:Name="FieldEditBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Label DockPanel.Dock="Left" Padding="0,0,8,0" VerticalAlignment="Center"
                               Target="{Binding ElementName=GroupSelector}"
                               Content="{Binding [PasswordGroupLabel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <ComboBox x:Name="GroupSelector" MinWidth="110" MaxWidth="220"
                                  ItemsSource="{Binding GroupOptions}"
                                  ItemTemplate="{StaticResource GroupOptionTemplate}"
                                  SelectedItem="{Binding DraftGroup, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal"
                        Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Margin="0,0,8,0" Command="{Binding SaveEditCommand}" Style="{DynamicResource AccentButtonStyle}"
                        Content="{Binding [Save], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <Button Command="{Binding CancelEditCommand}"
                        Content="{Binding [CancelEdit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

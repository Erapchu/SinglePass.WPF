<UserControl
    x:Class="SinglePass.WPF.Views.Controls.SecurityControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SinglePass.WPF.Controls"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core"
    xmlns:settings="clr-namespace:SinglePass.WPF.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="ChangePasswordButton" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                            Command="{Binding ChangePasswordCommand}"
                            Content="{Binding [Change], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <Label Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Content="{Binding [ChangePassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=ChangePasswordButton}" />
                </DockPanel>
            </Border>
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <DockPanel>
                    <ComboBox x:Name="IdleLockSelector" DockPanel.Dock="Right" MinWidth="164" Margin="12,0,0,0"
                              VerticalAlignment="Center" SelectedValue="{Binding IdleLockTimeout, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{Binding [IdleLockDisabled], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.Disabled}" />
                        <ComboBoxItem Content="{Binding [IdleLockFiveMinutes], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.FiveMinutes}" />
                        <ComboBoxItem Content="{Binding [IdleLockTenMinutes], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.TenMinutes}" />
                        <ComboBoxItem Content="{Binding [IdleLockFifteenMinutes], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.FifteenMinutes}" />
                        <ComboBoxItem Content="{Binding [IdleLockThirtyMinutes], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.ThirtyMinutes}" />
                        <ComboBoxItem Content="{Binding [IdleLockOneHour], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.OneHour}" />
                        <ComboBoxItem Content="{Binding [IdleLockTwoHours], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.TwoHours}" />
                    </ComboBox>
                    <Label Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Content="{Binding [LockAfterInactivity], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=IdleLockSelector}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <controls:ToggleSwitch x:Name="WindowsLockToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.LabeledBy="{Binding ElementName=WindowsLockLabel}"
                                  IsChecked="{Binding LockOnWindowsLock, Mode=TwoWay}" />
                    <Label x:Name="WindowsLockLabel" Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Target="{Binding ElementName=WindowsLockToggle}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding [LockOnWindowsLock], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </Label>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

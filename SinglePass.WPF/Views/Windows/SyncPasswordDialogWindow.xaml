<Window
    x:Class="SinglePass.WPF.Views.Windows.SyncPasswordDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language"
    Title="{x:Static properties:Resources.InputPasswordOfFile}"
    Width="400"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    FocusManager.FocusedElement="{Binding ElementName=PasswordInput}">
    <StackPanel Margin="24">
        <Label Padding="0,0,0,6" Content="{x:Static properties:Resources.Password}" Target="{Binding ElementName=PasswordInput}" />
        <PasswordBox FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}" x:Name="PasswordInput" PasswordChanged="PasswordInput_Changed" />
        <StackPanel Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                x:Name="AcceptButton"
                Margin="0,0,8,0"
                Click="Accept_Click"
                Content="{x:Static properties:Resources.OK}"
                IsDefault="True"
                IsEnabled="False"
                Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{x:Static properties:Resources.Cancel}" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

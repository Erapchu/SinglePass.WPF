<UserControl
    x:Class="Erapkey.Desktop.Views.Controls.CloudSyncControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cloud="clr-namespace:Erapkey.Core.Clouds.Enums;assembly=Erapkey.Core"
    xmlns:conv="clr-namespace:Erapkey.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:Erapkey.Desktop.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core"
    xmlns:vm="clr-namespace:Erapkey.Desktop.ViewModels"
    d:DataContext="{x:Static vm:CloudSyncViewModel.DesignTimeInstance}"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ProfileSkeleton" TargetType="Shape">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.13" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(helpers:UiAnimations.IsEnabled), RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding Path=(SystemParameters.ClientAreaAnimation)}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="ProfilePulse">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.10" To="0.23"
                                                 Duration="0:0:0.75" AutoReverse="True" RepeatBehavior="Forever" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="ProfilePulse" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CloudAccountTemplate">
            <Border Margin="8" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Google Drive" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static cloud:CloudType.YandexDisk}">
                                        <Setter Property="Text" Value="{Binding [YandexDisk], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Type}"
                        Content="{Binding [SignIn], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                        IsEnabled="{Binding CanSignIn}"
                        Style="{DynamicResource AccentButtonStyle}"
                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Text" Value="{Binding [YandexDiskOAuthNotConfigured], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static cloud:CloudType.GoogleDrive}">
                                        <Setter Property="Text" Value="{Binding [GoogleDriveOAuthNotConfigured], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnected}" Value="False" />
                                            <Condition Binding="{Binding CanSignIn}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Height="36" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource ProfileSkeleton}"
                                     Visibility="{Binding FetchingUserInfo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Ellipse Visibility="{Binding FetchingUserInfo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ProfileImage}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Rectangle Grid.Column="1" Width="116" Height="12" RadiusX="4" RadiusY="4"
                                       Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle" BasedOn="{StaticResource ProfileSkeleton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FetchingUserInfo}" Value="True" />
                                                    <Condition Binding="{Binding UserName}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding UserName}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Margin="0,0,0,8" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay">
                                    <MultiBinding.Converter>
                                        <conv:LocalizedFormatConverter />
                                    </MultiBinding.Converter>
                                    <Binding Path="[LastSyncFormatted]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                    <Binding Path="LastSyncTime" />
                                </MultiBinding>
                            </TextBlock.Text>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastSyncTime}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <WrapPanel>
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.TransferInProgress, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <Button
                                Margin="0,0,8,4"
                                Command="{Binding DataContext.SyncCredentialsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Type}"
                                Content="{Binding [Sync], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                            <Button
                                Margin="0,0,0,4"
                                Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Type}"
                                Content="{Binding [SignOut], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        </WrapPanel>
                        <StackPanel Visibility="{Binding Transferring, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True" />
                            <TextBlock
                                Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SyncState}"
                                AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ContentControl Content="{Binding GoogleDrive}" ContentTemplate="{StaticResource CloudAccountTemplate}" />
            <ContentControl Content="{Binding YandexDisk}" ContentTemplate="{StaticResource CloudAccountTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="Erapkey.Desktop.Views.Controls.Entries.SshKeyEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:evm="clr-namespace:Erapkey.Desktop.ViewModels.Entries"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core"
    d:DataContext="{d:DesignInstance Type=evm:SshKeyViewModel}"
    mc:Ignorable="d"
    IsTabStop="False" Focusable="False"
    DataContextChanged="Editor_DataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary Source="EntryResources.xaml" />
    </UserControl.Resources>
    <!-- Editor of an SSH key draft. DataContext: SshKeyViewModel of the draft. -->
    <StackPanel>
        <WrapPanel Margin="0,0,0,6">
            <Button Margin="0,0,8,6" Click="ImportSshKey_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8E5;" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding [ImportSshKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button Margin="0,0,8,6" Click="GenerateSshKey_Click"
                    Visibility="{Binding HasPrivateKey, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE710;" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding [GenerateSshKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </WrapPanel>
        <TextBlock x:Name="SshKeyStatus" Margin="0,0,0,6" Style="{StaticResource StatusText}" />
        <Label Padding="0,0,0,6" Content="{Binding [PrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PrivateKeyEditBox}" />
        <TextBox x:Name="PrivateKeyEditBox" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" MinHeight="64" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                 Text="{Binding PrivateKey, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding [SshKeyEncrypted], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                   Visibility="{Binding IsEncrypted, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Passphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PassphraseEditBox}" />
        <TextBox x:Name="PassphraseEditBox" MaxLength="1000"
                 FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                 Text="{Binding Passphrase, UpdateSourceTrigger=PropertyChanged}" />
        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [PublicKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PublicKeyEditBox}" />
        <TextBox x:Name="PublicKeyEditBox" MaxLength="20000" TextWrapping="Wrap" FontFamily="Consolas"
                 MaxHeight="120" VerticalScrollBarVisibility="Auto"
                 Text="{Binding PublicKey, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Visibility="{Binding HasKeyInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock.Text>
                <MultiBinding Mode="OneWay" StringFormat="{}{0} ({1})">
                    <Binding Path="KeyInfo.Fingerprint" />
                    <Binding Path="KeyInfo.KeyType" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </StackPanel>
</UserControl>

<UserControl
    x:Class="SinglePass.WPF.Views.Controls.MessageDialogCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels.Dialogs"
    d:DataContext="{x:Static vm:MessageDialogViewModel.DesignTimeInstance}"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Margin="16,16,16,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel>
                    <TextBlock Margin="0,2,10,0" VerticalAlignment="Top" Style="{StaticResource SymbolText}"
                               Text="{Binding Glyph}"
                               Visibility="{Binding IconVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Header}" />
                </DockPanel>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding Content}" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="Footer" Grid.Row="1">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="0,0,7,7"
                    IsHitTestVisible="False" />
            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    Padding="11,14">
                <!-- UniformGrid skips collapsed buttons, so visible ones share the width. -->
                <UniformGrid Rows="1">
                    <Button x:Name="Button1" Margin="5,0" Padding="6,4" MinHeight="36" HorizontalAlignment="Stretch"
                            Command="{Binding Button1ActionCommand}" Content="{Binding Button1Text}" />
                    <Button x:Name="Button2" Margin="5,0" Padding="6,4" MinHeight="36" HorizontalAlignment="Stretch"
                            Command="{Binding Button2ActionCommand}" Content="{Binding Button2Text}"
                            Visibility="{Binding Button2Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="Button3" Margin="5,0" Padding="6,4" MinHeight="36" HorizontalAlignment="Stretch"
                            Command="{Binding Button3ActionCommand}" Content="{Binding Button3Text}"
                            Visibility="{Binding Button3Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </UniformGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

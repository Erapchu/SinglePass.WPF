<UserControl
    x:Class="SinglePass.WPF.Views.Controls.AboutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SinglePass.WPF.Views.Controls"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="8" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="SinglePass" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="{Binding [AppVersion], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <Run Text=" " /><Run Text="{x:Static controls:AboutControl.AppVersion}" />
                </TextBlock>
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                           Text="{Binding [AboutDescription], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://github.com/Erapchu/SinglePass.WPF" RequestNavigate="OpenLink">
                        <Run Text="{Binding [AboutProjectLink], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="{Binding [AboutFounder], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <Run Text=" " /><Hyperlink NavigateUri="https://github.com/Erapchu" RequestNavigate="OpenLink">Andrey Nasonov</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

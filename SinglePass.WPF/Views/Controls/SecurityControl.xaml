<UserControl
    x:Class="SinglePass.WPF.Views.Controls.SecurityControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SinglePass.WPF.Controls"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core"
    xmlns:settings="clr-namespace:SinglePass.WPF.Settings">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadBackupsCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <DockPanel>
                    <Button x:Name="ChangePasswordButton" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                            Command="{Binding ChangePasswordCommand}"
                            Content="{Binding [Change], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <Label Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Content="{Binding [ChangePassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=ChangePasswordButton}" />
                </DockPanel>
            </Border>
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <DockPanel>
                    <ComboBox x:Name="IdleLockSelector" DockPanel.Dock="Right" MinWidth="164" Margin="12,0,0,0"
                              VerticalAlignment="Center" SelectedValue="{Binding IdleLockTimeout, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{Binding [IdleLockDisabled], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.Disabled}" />
                        <ComboBoxItem Content="{Binding [IdleLockFiveMinutes], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.FiveMinutes}" />
                        <ComboBoxItem Content="{Binding [IdleLockTenMinutes], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.TenMinutes}" />
                        <ComboBoxItem Content="{Binding [IdleLockFifteenMinutes], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.FifteenMinutes}" />
                        <ComboBoxItem Content="{Binding [IdleLockThirtyMinutes], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.ThirtyMinutes}" />
                        <ComboBoxItem Content="{Binding [IdleLockOneHour], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.OneHour}" />
                        <ComboBoxItem Content="{Binding [IdleLockTwoHours], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:IdleLockTimeout.TwoHours}" />
                    </ComboBox>
                    <Label Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Content="{Binding [LockAfterInactivity], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=IdleLockSelector}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <controls:ToggleSwitch x:Name="WindowsLockToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  AutomationProperties.LabeledBy="{Binding ElementName=WindowsLockLabel}"
                                  IsChecked="{Binding LockOnWindowsLock, Mode=TwoWay}" />
                    <Label x:Name="WindowsLockLabel" Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Target="{Binding ElementName=WindowsLockToggle}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding [LockOnWindowsLock], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </Label>
                </DockPanel>
            </Border>
            <Border Margin="0,8,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <controls:ToggleSwitch x:Name="WindowsHelloToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.LabeledBy="{Binding ElementName=WindowsHelloLabel}"
                                      IsChecked="{Binding WindowsHelloEnabled, Mode=TwoWay}">
                            <controls:ToggleSwitch.Style>
                                <Style TargetType="controls:ToggleSwitch">
                                    <Style.Triggers>
                                        <!-- Turning it off stays possible after Windows Hello was removed from the computer -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsWindowsHelloAvailable}" Value="False" />
                                                <Condition Binding="{Binding WindowsHelloEnabled}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:ToggleSwitch.Style>
                        </controls:ToggleSwitch>
                        <Label x:Name="WindowsHelloLabel" Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Target="{Binding ElementName=WindowsHelloToggle}"
                               Content="{Binding [UnlockWithWindowsHello], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding [WindowsHelloDescription], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWindowsHelloAvailable}" Value="False">
                                        <Setter Property="Text" Value="{Binding [WindowsHelloUnavailable], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Margin="0,8,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <controls:ToggleSwitch x:Name="SshAgentToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.LabeledBy="{Binding ElementName=SshAgentLabel}"
                                      IsChecked="{Binding SshAgentEnabled, Mode=TwoWay}" />
                        <Label x:Name="SshAgentLabel" Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Target="{Binding ElementName=SshAgentToggle}"
                               Content="{Binding [SshAgent], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding [SshAgentDescription], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <DockPanel Margin="0,8,0,0" Visibility="{Binding IsSshAgentRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                                Command="{Binding CopySshAgentPipePathCommand}"
                                AutomationProperties.Name="{Binding [CopySshAgentPipe], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopySshAgentPipe], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                        </Button>
                        <TextBox IsReadOnly="True" FontFamily="Consolas" Text="{Binding SshAgentPipePath, Mode=OneWay}"
                                 AutomationProperties.Name="SSH_AUTH_SOCK" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Border Margin="0,8,0,0" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                Command="{Binding OpenBackupsFolderCommand}"
                                Content="{Binding [OpenBackupsFolder], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
                                   Text="{Binding [Backups], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding [BackupsDescription], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <TextBlock Margin="0,8,0,0" Visibility="Collapsed"
                               Text="{Binding [NoBackups], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Backups}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RestoringBackup}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,8,0,0">
                                    <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="{Binding [Restore], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd-MM-yyyy, HH:mm:ss}'}" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding Reason}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="SinglePass.WPF.Views.Controls.CredentialsDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
    </UserControl.Resources>
    <Border>
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedCredentialVM}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="4,0" Padding="6,4" Command="{Binding EditCommand}"
                            AutomationProperties.Name="{x:Static properties:Resources.Edit}" ToolTip="{x:Static properties:Resources.Edit}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE70F;" />
                    </Button>
                    <Button Padding="6,4" Command="{Binding DeleteCommand}"
                            AutomationProperties.Name="{x:Static properties:Resources.Delete}" ToolTip="{x:Static properties:Resources.Delete}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0" Source="{Binding SelectedCredentialVM.FavIcon32}" />
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedCredentialVM.NameFieldVM.Value}" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,4,0">
                    <Label Padding="0,0,0,6" Content="{x:Static properties:Resources.Login}" Target="{Binding ElementName=LoginTextBox}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                                Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.LoginFieldVM.Value}"
                                AutomationProperties.Name="{x:Static properties:Resources.CopyLogin}" ToolTip="{x:Static properties:Resources.CopyLogin}">
                            <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                        </Button>
                        <TextBox x:Name="LoginTextBox" IsReadOnly="True" Text="{Binding SelectedCredentialVM.LoginFieldVM.Value, Mode=OneWay}" />
                    </DockPanel>
                    <TextBlock Margin="0,12,0,6" Text="{x:Static properties:Resources.Password}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Margin="4,0,0,0" Padding="6,4" IsChecked="{Binding IsPasswordVisible}"
                                          AutomationProperties.Name="{x:Static properties:Resources.ShowHidePassword}" ToolTip="{x:Static properties:Resources.ShowHidePassword}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                                            <Setter Property="Text" Value="&#xE890;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter Property="Text" Value="&#xED1A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ToggleButton>
                            <Button Margin="4,0,0,0" Padding="6,4"
                                    Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.PasswordFieldVM.Value}"
                                    AutomationProperties.Name="{x:Static properties:Resources.CopyPassword}" ToolTip="{x:Static properties:Resources.CopyPassword}">
                                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                            </Button>
                        </StackPanel>
                        <Grid>
                            <TextBox IsReadOnly="True" AutomationProperties.Name="{x:Static properties:Resources.Password}"
                                     Text="{Binding SelectedCredentialVM.PasswordFieldVM.Value, Mode=OneWay}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <PasswordBox x:Name="PasswordFieldBox" Focusable="False" IsHitTestVisible="False"
                                         AutomationProperties.Name="{x:Static properties:Resources.Password}"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{x:Static properties:Resources.Website}" Target="{Binding ElementName=WebsiteTextBox}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                                Command="{Binding OpenInBrowserCommand}"
                                AutomationProperties.Name="{x:Static properties:Resources.OpenInBrowser}" ToolTip="{x:Static properties:Resources.OpenInBrowser}">
                            <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8A7;" />
                        </Button>
                        <TextBox x:Name="WebsiteTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                 Text="{Binding SelectedCredentialVM.SiteFieldVM.Value, Mode=OneWay}" />
                    </DockPanel>
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{x:Static properties:Resources.Other}" Target="{Binding ElementName=OtherTextBox}" />
                    <TextBox x:Name="OtherTextBox" IsReadOnly="True" TextWrapping="Wrap"
                             Text="{Binding SelectedCredentialVM.OtherFieldVM.Value, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{Binding SelectedCredentialVM.AdditionalFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <Label Padding="0,0,0,6" Content="{Binding Name}" Target="{Binding ElementName=FieldValue}" />
                                    <TextBox x:Name="FieldValue" IsReadOnly="True" Text="{Binding Value, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="{Binding SelectedCredentialVM.LastModifiedTime, StringFormat={x:Static properties:Resources.ModifiedFormatted}}" />
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="{Binding SelectedCredentialVM.CreationTime, StringFormat={x:Static properties:Resources.CreatedFormatted}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

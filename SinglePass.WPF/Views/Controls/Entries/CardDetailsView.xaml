<UserControl
    x:Class="SinglePass.WPF.Views.Controls.Entries.CardDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctl="clr-namespace:SinglePass.WPF.Views.Controls"
    xmlns:evm="clr-namespace:SinglePass.WPF.ViewModels.Entries"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core"
    d:DataContext="{d:DesignInstance Type=evm:CardViewModel}"
    mc:Ignorable="d"
    IsTabStop="False" Focusable="False"
    DataContextChanged="View_DataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary Source="EntryResources.xaml" />
    </UserControl.Resources>
    <!-- Read-only view of a payment card. DataContext: CardViewModel. Number, CVV and PIN are hidden
         again for every card shown; the hidden number keeps its last four digits visible. -->
    <StackPanel>
        <StackPanel Visibility="{Binding HasNumber, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="0,0,0,6" Text="{Binding [CardNumber], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="RevealNumber" Margin="4,0,0,0" Padding="6,4"
                                  AutomationProperties.Name="{Binding [ShowHideCardNumber], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHideCardNumber], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RevealGlyph}" />
                    </ToggleButton>
                    <Button Margin="4,0,0,0" Padding="6,4"
                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                            CommandParameter="{Binding NumberDigits}"
                            AutomationProperties.Name="{Binding [CopyCardNumber], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyCardNumber], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                    </Button>
                </StackPanel>
                <Grid>
                    <TextBox IsReadOnly="True" FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             AutomationProperties.Name="{Binding [CardNumber], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                             Text="{Binding FormattedNumber, Mode=OneWay}"
                             Visibility="{Binding IsChecked, ElementName=RevealNumber, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             Text="{Binding MaskedNumber, Mode=OneWay, TargetNullValue=&#x25CF;&#x25CF;&#x25CF;&#x25CF;}"
                             Visibility="{Binding IsChecked, ElementName=RevealNumber, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
            <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding BrandName}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BrandName}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <StackPanel Visibility="{Binding HasHolder, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [CardHolder], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=HolderTextBox}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                        Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                        CommandParameter="{Binding Holder}"
                        AutomationProperties.Name="{Binding [CopyCardHolder], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyCardHolder], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                </Button>
                <TextBox x:Name="HolderTextBox" IsReadOnly="True" Text="{Binding Holder, Mode=OneWay}" />
            </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding HasExpiry, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [CardExpiry], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=ExpiryTextBox}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                        Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                        CommandParameter="{Binding Expiry}"
                        AutomationProperties.Name="{Binding [CopyCardExpiry], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyCardExpiry], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                </Button>
                <TextBox x:Name="ExpiryTextBox" IsReadOnly="True" FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                         Text="{Binding Expiry, Mode=OneWay}" />
            </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding HasCvv, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="0,12,0,6" Text="{Binding [CardCvv], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="RevealCvv" Margin="4,0,0,0" Padding="6,4"
                                  AutomationProperties.Name="{Binding [ShowHideCvv], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHideCvv], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RevealGlyph}" />
                    </ToggleButton>
                    <Button Margin="4,0,0,0" Padding="6,4"
                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                            CommandParameter="{Binding Cvv}"
                            AutomationProperties.Name="{Binding [CopyCvv], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyCvv], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                    </Button>
                </StackPanel>
                <Grid>
                    <TextBox IsReadOnly="True" FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             AutomationProperties.Name="{Binding [CardCvv], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                             Text="{Binding Cvv, Mode=OneWay}"
                             Visibility="{Binding IsChecked, ElementName=RevealCvv, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             Text="&#x25CF;&#x25CF;&#x25CF;"
                             Visibility="{Binding IsChecked, ElementName=RevealCvv, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding HasPin, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="0,12,0,6" Text="{Binding [CardPin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="RevealPin" Margin="4,0,0,0" Padding="6,4"
                                  AutomationProperties.Name="{Binding [ShowHidePin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHidePin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RevealGlyph}" />
                    </ToggleButton>
                    <Button Margin="4,0,0,0" Padding="6,4"
                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                            CommandParameter="{Binding Pin}"
                            AutomationProperties.Name="{Binding [CopyPin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                    </Button>
                </StackPanel>
                <Grid>
                    <TextBox IsReadOnly="True" FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             AutomationProperties.Name="{Binding [CardPin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                             Text="{Binding Pin, Mode=OneWay}"
                             Visibility="{Binding IsChecked, ElementName=RevealPin, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             Text="&#x25CF;&#x25CF;&#x25CF;&#x25CF;"
                             Visibility="{Binding IsChecked, ElementName=RevealPin, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</UserControl>

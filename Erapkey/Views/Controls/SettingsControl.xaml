<UserControl
    x:Class="Erapkey.Views.Controls.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Erapkey.Views.Controls"
    xmlns:toggle="clr-namespace:Erapkey.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core"
    xmlns:vm="clr-namespace:Erapkey.ViewModels"
    d:DataContext="{x:Static vm:SettingsViewModel.DesignTimeInstance}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="SettingsCardIcon" TargetType="Path">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Button
                x:Name="AppearanceButton"
                MinHeight="64"
                Margin="0,0,0,8"
                Padding="16,10"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="{Binding [Appearance], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Command="{x:Static controls:SettingsControl.OpenAppearanceCommand}">
                <DockPanel>
                    <Path Style="{StaticResource SettingsCardIcon}"
                          Data="M 5,2 H 19 V 12 Q 19,16 15,16 H 14 V 22 A 2,2 0 0 1 10,22 V 16 H 9 Q 5,16 5,12 Z M 5,12 H 19 M 10,2 V 8 M 15,2 V 6" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"
                               FontSize="12" Style="{StaticResource SymbolText}" Text="&#xE76C;" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{Binding [Appearance], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                </DockPanel>
            </Button>
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <DockPanel>
                    <Path Style="{StaticResource SettingsCardIcon}"
                          Data="M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 Z M 12,2 A 4,10 0 1 1 12,22 A 4,10 0 1 1 12,2 Z M 3,8 H 21 M 3,16 H 21" />
                    <ComboBox x:Name="LanguageSelector" DockPanel.Dock="Right" MinWidth="164" Margin="12,0,0,0" VerticalAlignment="Center"
                              SelectedValue="{Binding Language, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{Binding [SystemLanguage], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="system" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Русский" Tag="ru" />
                    </ComboBox>
                    <Label Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Content="{Binding [Language], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=LanguageSelector}" />
                </DockPanel>
            </Border>
            <Button
                x:Name="SecurityButton"
                MinHeight="64"
                Margin="0,0,0,8"
                Padding="16,10"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="{Binding [Security], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Command="{x:Static controls:SettingsControl.OpenSecurityCommand}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="20" Margin="0,0,16,0"
                               FontSize="20" Style="{StaticResource SymbolText}" Text="&#xE72E;" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"
                               FontSize="12" Style="{StaticResource SymbolText}" Text="&#xE76C;" />
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{Binding [Security], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                </DockPanel>
            </Button>
            <Button
                x:Name="CloudSyncButton"
                MinHeight="64"
                Margin="0,0,0,8"
                Padding="16,10"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="{Binding [CloudSync], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Command="{x:Static controls:SettingsControl.OpenCloudSyncCommand}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="20" Margin="0,0,16,0"
                               FontSize="20" Style="{StaticResource SymbolText}" Text="&#xE753;" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"
                               FontSize="12" Style="{StaticResource SymbolText}" Text="&#xE76C;" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding [CloudSync], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding [CloudProviders], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <toggle:ToggleSwitch x:Name="PopupHotkeyToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                             VerticalAlignment="Center"
                                             AutomationProperties.LabeledBy="{Binding ElementName=PopupHotkeyLabel}"
                                             IsChecked="{Binding PopupHotkeyEnabled, Mode=TwoWay}" />
                        <Path Style="{StaticResource SettingsCardIcon}"
                              Data="M 2,5 H 22 V 19 H 2 Z M 5,9 H 7 M 9,9 H 11 M 13,9 H 15 M 17,9 H 19 M 5,12 H 7 M 9,12 H 11 M 13,12 H 15 M 17,12 H 19 M 7,15 H 17" />
                        <Label x:Name="PopupHotkeyLabel" Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Target="{Binding ElementName=PopupHotkeyToggle}"
                               Content="{Binding [PopupHotkey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </DockPanel>
                    <TextBlock Margin="36,4,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding [PopupHotkeyDescription], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding PopupHotkeyEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Label Padding="0,0,0,6" Content="{Binding [Hotkey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PopupHotkeyBox}" />
                        <DockPanel>
                            <Button
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Command="{Binding ClearShowPopupHotkeyCommand}"
                                AutomationProperties.Name="{Binding [ClearHotkey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                ToolTip="{Binding [ClearHotkey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE711;" />
                            </Button>
                            <TextBox x:Name="PopupHotkeyBox" IsReadOnly="True" Text="{Binding ShowPopupHotkey, Mode=OneWay}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="PreviewKeyDown">
                                        <i:InvokeCommandAction Command="{Binding ChangeHelperPopupHotkeyCommand}" PassEventArgsToCommand="True" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                            <Run FontWeight="Bold" Text="Enter" />
                            <Run Text="{Binding [ToPasteCombination], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                            <LineBreak />
                            <Run FontWeight="Bold" Text="Ctrl + '#'" />
                            <Run Text="{Binding [ToPasteLoginOrPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Button
                x:Name="AboutButton"
                MinHeight="64"
                Padding="16,10"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                AutomationProperties.Name="{Binding [About], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Command="{x:Static controls:SettingsControl.OpenAboutCommand}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Width="20" Margin="0,0,16,0"
                               FontSize="20" Style="{StaticResource SymbolText}" Text="&#xE946;" />
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0"
                               FontSize="12" Style="{StaticResource SymbolText}" Text="&#xE76C;" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                                   Text="{Binding [About], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                            <Run Text="{Binding [AppVersion], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                            <Run Text=" " /><Run Text="{x:Static controls:AboutControl.AppVersion}" />
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding DataContext.Updates.UpdateAvailableText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.Updates.IsUpdateReady, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=False}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="SinglePass.WPF.Views.Controls.Entries.LoginEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entries="clr-namespace:SinglePass.WPF.Views.Controls.Entries"
    xmlns:evm="clr-namespace:SinglePass.WPF.ViewModels.Entries"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core"
    d:DataContext="{d:DesignInstance Type=evm:LoginViewModel}"
    mc:Ignorable="d"
    IsTabStop="False" Focusable="False"
    DataContextChanged="Editor_DataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary Source="EntryResources.xaml" />
    </UserControl.Resources>
    <!-- Editor of a login draft. DataContext: LoginViewModel of the draft. -->
    <StackPanel>
        <Label Padding="0,0,0,6" Content="{Binding [Login], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=LoginEditBox}" />
        <TextBox x:Name="LoginEditBox" MaxLength="200"
                 Text="{Binding LoginFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PasswordEditBox}" />
        <TextBox x:Name="PasswordEditBox" MaxLength="200"
                 FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                 Text="{Binding PasswordFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
        <StackPanel Margin="0,12,0,0"
                    Visibility="{Binding ShowCurrentTotp, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="0,0,0,6" Text="{Binding [TotpCode], Source={x:Static loc:LocalizationManager.Instance}}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Margin="4,0,0,0" Padding="6,4" Click="ReplaceTotp_Click"
                            AutomationProperties.Name="{Binding [ReplaceTotp], Source={x:Static loc:LocalizationManager.Instance}}"
                            ToolTip="{Binding [ReplaceTotp], Source={x:Static loc:LocalizationManager.Instance}}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE70F;" />
                    </Button>
                    <Button Margin="4,0,0,0" Padding="6,4" Click="RemoveTotp_Click"
                            AutomationProperties.Name="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}}"
                            ToolTip="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <entries:TotpCodeDisplay Configuration="{Binding Totp}" />
            </DockPanel>
        </StackPanel>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                   Visibility="{Binding RemoveTotp, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Text="{Binding [TotpRemovalPending], Source={x:Static loc:LocalizationManager.Instance}}" />
        <StackPanel Visibility="{Binding ShowTotpSetup, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label Margin="0,12,0,0" Padding="0,0,0,6" Target="{Binding ElementName=TotpSetupBox}"
                   Content="{Binding [TotpSetup], Source={x:Static loc:LocalizationManager.Instance}}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Click="PasteTotpQr_Click"
                        IsEnabled="{Binding RemoveTotp, Converter={StaticResource InverseBooleanConverter}}"
                        Content="{Binding [PasteTotpQr], Source={x:Static loc:LocalizationManager.Instance}}" />
                <PasswordBox x:Name="TotpSetupBox" MaxLength="4096"
                             PasswordChanged="TotpSetupBox_PasswordChanged"
                             IsEnabled="{Binding RemoveTotp, Converter={StaticResource InverseBooleanConverter}}" />
            </DockPanel>
            <TextBlock x:Name="TotpQrStatus" Margin="0,6,0,0" Style="{StaticResource StatusText}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Visibility="{Binding HasInvalidTotp, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Text="{Binding [InvalidTotp], Source={x:Static loc:LocalizationManager.Instance}}" />
        </StackPanel>
        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Website], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=WebsiteEditBox}" />
        <TextBox x:Name="WebsiteEditBox" MaxLength="5000" TextWrapping="Wrap"
                 Text="{Binding SiteFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>

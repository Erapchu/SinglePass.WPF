<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only (DPAPI, WindowsIdentity), but no WPF/WinForms references: UI code does not belong here. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Erapkey" />
    <InternalsVisibleTo Include="Erapkey.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erapkey.Language\Erapkey.Language.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- https://publicsuffix.org/list/public_suffix_list.dat (MPL 2.0); update before releases. -->
    <EmbeddedResource Include="Resources\public_suffix_list.dat" LogicalName="Erapkey.Core.public_suffix_list.dat" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncKeyedLock" Version="8.1.3" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

</Project>

<UserControl
    x:Class="SinglePass.WPF.Views.Controls.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization"
    xmlns:settings="clr-namespace:SinglePass.WPF.Settings"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    d:DataContext="{x:Static vm:SettingsViewModel.DesignTimeInstance}"
    DataContextChanged="UserControl_DataContextChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <StackPanel>
                    <Label Padding="0,0,0,8" FontWeight="SemiBold" Content="{Binding [Theme], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=ThemeSelector}" />
                    <ComboBox x:Name="ThemeSelector" MinWidth="150" HorizontalAlignment="Left"
                              SelectedValue="{Binding ThemeMode, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{Binding [System], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:AppTheme.Inherit}" />
                        <ComboBoxItem Content="{Binding [Light], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:AppTheme.Light}" />
                        <ComboBoxItem Content="{Binding [Dark], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:AppTheme.Dark}" />
                    </ComboBox>
                    <Label Padding="0,12,0,8" FontWeight="SemiBold" Content="{Binding [Language], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=LanguageSelector}" />
                    <ComboBox x:Name="LanguageSelector" MinWidth="150" HorizontalAlignment="Left"
                              SelectedValue="{Binding Language, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{Binding [SystemLanguage], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="system" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="Русский" Tag="ru" />
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding [ChangePassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <Label Padding="0,0,0,6" Content="{Binding [NewPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=NewPasswordBox}" />
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Command="{Binding ChangePasswordCommand}"
                            Content="{Binding [Change], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <PasswordBox FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}" x:Name="NewPasswordBox" MaxLength="32" PasswordChanged="PasswordBox_PasswordChanged" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Text="{Binding [Minimum8Characters], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                               Visibility="{Binding ShowPasswordLengthError, Converter={StaticResource BooleanToVisibilityConverter}}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{Binding [Hotkeys], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <Label Padding="0,0,0,6" Content="{Binding [Popup], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PopupHotkeyBox}" />
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Command="{Binding ClearShowPopupHotkeyCommand}"
                            AutomationProperties.Name="{Binding [ClearHotkey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                            ToolTip="{Binding [ClearHotkey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SymbolText}" Text="&#xE711;" />
                        </Button>
                        <TextBox x:Name="PopupHotkeyBox" IsReadOnly="True" Text="{Binding ShowPopupHotkey, Mode=OneWay}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewKeyDown">
                                    <i:InvokeCommandAction Command="{Binding ChangeHelperPopupHotkeyCommand}" PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run FontWeight="Bold" Text="Enter" />
                        <Run Text="{Binding [ToPasteCombination], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <LineBreak />
                        <Run FontWeight="Bold" Text="Ctrl + '#'" />
                        <Run Text="{Binding [ToPasteLoginOrPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

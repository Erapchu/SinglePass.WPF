<Window
    x:Class="SinglePass.WPF.Views.Windows.CredentialEditDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dvm="clr-namespace:SinglePass.WPF.ViewModels.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language"
    Title="{Binding CaptionText}"
    Width="380"
    Height="520"
    MinWidth="300"
    MinHeight="340"
    d:DataContext="{d:DesignInstance Type=dvm:CredentialEditViewModel, IsDesignTimeCreatable=False}"
    Closed="Window_Closed"
    FocusManager.FocusedElement="{Binding ElementName=NameTextBox}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <Label Padding="0,0,0,6" Content="{x:Static properties:Resources.Name}" Target="{Binding ElementName=NameTextBox}" />
                <TextBox x:Name="NameTextBox" MaxLength="200"
                         Text="{Binding CredentialViewModel.NameFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                <Label Margin="0,10,0,0" Padding="0,0,0,6" Content="{x:Static properties:Resources.Login}" Target="{Binding ElementName=LoginTextBox}" />
                <TextBox x:Name="LoginTextBox" MaxLength="200"
                         Text="{Binding CredentialViewModel.LoginFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                <Label Margin="0,10,0,0" Padding="0,0,0,6" Content="{x:Static properties:Resources.Password}" Target="{Binding ElementName=PasswordTextBox}" />
                <TextBox x:Name="PasswordTextBox" MaxLength="200"
                         Text="{Binding CredentialViewModel.PasswordFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                <Label Margin="0,10,0,0" Padding="0,0,0,6" Content="{x:Static properties:Resources.Website}" Target="{Binding ElementName=WebsiteTextBox}" />
                <TextBox x:Name="WebsiteTextBox" MaxLength="5000" TextWrapping="Wrap"
                         Text="{Binding CredentialViewModel.SiteFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                <Label Margin="0,10,0,0" Padding="0,0,0,6" Content="{x:Static properties:Resources.Other}" Target="{Binding ElementName=OtherTextBox}" />
                <TextBox x:Name="OtherTextBox" AcceptsReturn="True" MaxLength="5000" TextWrapping="Wrap"
                         Text="{Binding CredentialViewModel.OtherFieldVM.Value, UpdateSourceTrigger=PropertyChanged}" />
                <ItemsControl ItemsSource="{Binding CredentialViewModel.AdditionalFields}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,10,0,0">
                                <Label Padding="0,0,0,6" Content="{Binding Name}" Target="{Binding ElementName=FieldValue}" />
                                <TextBox x:Name="FieldValue" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,8,0" Command="{Binding OkCommand}" Content="{Binding CaptionText}"
                    IsDefault="True" Style="{DynamicResource AccentButtonStyle}" />
            <Button Command="{Binding CancelCommand}" Content="{x:Static properties:Resources.Cancel}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

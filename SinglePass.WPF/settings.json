{
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "extensions": [
      { "assembly": "NLog.Extensions.Logging" }
    ],
    "variables": {
      "logName": "SinglePass",
      "logDir": "${specialfolder:folder=LocalApplicationData}/SinglePass/Logs",
      "logDirArchive": "${var:logDir}/Archive",
      "logLayout": "[${date:format=yyyy-MM-dd HH\\:mm\\:ss,fff}] ${level:uppercase=true:padding=5} [${threadid:padding=2}] ${callsite:includeNamespace=False:cleanNamesOfAnonymousDelegates=True:cleanNamesOfAsyncContinuations=True}> ${message} ${exception:format=toString:innerFormat=toString}"
    },
    "targets": {
      "async": true,
      "file": {
        "type": "File",
        "archiveAboveSize": 31457280,
        "ArchiveDateFormat": "yyyyMMdd",
        "archiveEvery": "Month",
        "archiveFileName": "${logDirArchive}/${logName}.{##}.log",
        "archiveNumbering": "DateAndSequence",
        "autoFlush": "true",
        "createDirs": "true",
        "deleteOldFileOnStartup": "false",
        "encoding": "utf-8",
        "fileName": "${logDir}/${logName}.log",
        "layout": "${logLayout}",
        "maxArchiveFiles": 50
      }
    },
    "rules": [
      {
        "logger": "Microsoft.EntityFrameworkCore.Database.Command",
        "finalMinLevel": "Warn"
      },
      {
        "logger": "*",
        //"levels": "Trace,Debug,Info,Warn,Error,Fatal",
        "minLevel": "Info",
        "writeTo": "file"
      }
    ]
  },
  "FavIconCacheOptions": {
    "ConnectionString": "Data Source=%localappdata%/SinglePass/Cache/FavIcon.db"
  }
}

<UserControl
    x:Class="SinglePass.WPF.Views.Controls.CredentialDeleteConfirmation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization">
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Margin="16,16,16,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="{Binding [DeleteItem], Source={x:Static loc:LocalizationManager.Instance}}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding NameFieldVM.Value}" />
            </StackPanel>
        </ScrollViewer>
        <Grid x:Name="Footer" Grid.Row="1">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}" CornerRadius="0,0,7,7"
                    Opacity="0.4" IsHitTestVisible="False" />
            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    Padding="16,14">
                <UniformGrid Rows="1" Columns="2">
                    <Button x:Name="ConfirmButton" Margin="0,0,5,0" Padding="6,4" MinHeight="36"
                            HorizontalAlignment="Stretch" Content="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <Button x:Name="CancelButton" Margin="5,0,0,0" Padding="6,4" MinHeight="36"
                            HorizontalAlignment="Stretch" Content="{Binding [CancelEdit], Source={x:Static loc:LocalizationManager.Instance}}" />
                </UniformGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl
    x:Class="SinglePass.WPF.Views.Controls.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language"
    xmlns:settings="clr-namespace:SinglePass.WPF.Settings"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    d:DataContext="{x:Static vm:SettingsViewModel.DesignTimeInstance}"
    DataContextChanged="UserControl_DataContextChanged"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <StackPanel>
                    <Label Padding="0,0,0,8" FontWeight="SemiBold" Content="{x:Static properties:Resources.Theme}" Target="{Binding ElementName=ThemeSelector}" />
                    <ComboBox x:Name="ThemeSelector" MinWidth="150" HorizontalAlignment="Left"
                              SelectedValue="{Binding ThemeMode, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{x:Static properties:Resources.System}" Tag="{x:Static settings:AppTheme.Inherit}" />
                        <ComboBoxItem Content="{x:Static properties:Resources.Light}" Tag="{x:Static settings:AppTheme.Light}" />
                        <ComboBoxItem Content="{x:Static properties:Resources.Dark}" Tag="{x:Static settings:AppTheme.Dark}" />
                    </ComboBox>
                </StackPanel>
            </Border>
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{x:Static properties:Resources.ChangePassword}" />
                    <Label Padding="0,0,0,6" Content="{x:Static properties:Resources.NewPassword}" Target="{Binding ElementName=NewPasswordBox}" />
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Command="{Binding ChangePasswordCommand}"
                            Content="{x:Static properties:Resources.Change}" />
                        <PasswordBox FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}" x:Name="NewPasswordBox" MaxLength="32" PasswordChanged="PasswordBox_PasswordChanged" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Text="{Binding NewPasswordHelperText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontWeight="SemiBold" Text="{x:Static properties:Resources.Hotkeys}" />
                    <Label Padding="0,0,0,6" Content="{x:Static properties:Resources.Popup}" Target="{Binding ElementName=PopupHotkeyBox}" />
                    <DockPanel>
                        <Button
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Command="{Binding ClearShowPopupHotkeyCommand}"
                            AutomationProperties.Name="{x:Static properties:Resources.ClearHotkey}"
                            ToolTip="{x:Static properties:Resources.ClearHotkey}">
                            <TextBlock Style="{StaticResource SymbolText}" Text="&#xE711;" />
                        </Button>
                        <TextBox x:Name="PopupHotkeyBox" IsReadOnly="True" Text="{Binding ShowPopupHotkey, Mode=OneWay}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewKeyDown">
                                    <i:InvokeCommandAction Command="{Binding ChangeHelperPopupHotkeyCommand}" PassEventArgsToCommand="True" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBox>
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                        <Run FontWeight="Bold" Text="Enter" />
                        <Run Text="{x:Static properties:Resources.ToPasteCombination}" />
                        <LineBreak />
                        <Run FontWeight="Bold" Text="Ctrl + '#'" />
                        <Run Text="{x:Static properties:Resources.ToPasteLoginOrPassword}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SinglePass.WPF.Controls">
    <Style TargetType="{x:Type controls:ToggleSwitch}">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style TargetType="Control">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Control">
                                <Border Width="50" Height="28" CornerRadius="14"
                                        BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="1"
                                        IsHitTestVisible="False" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ToggleSwitch}">
                    <Grid Background="Transparent">
                        <Grid x:Name="Switch" Width="44" Height="22">
                            <Border CornerRadius="11"
                                    BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" BorderThickness="1" />
                            <Border x:Name="PART_OnTrack" CornerRadius="11"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Ellipse x:Name="PART_Thumb" Width="12" Height="12" Margin="5,0"
                                     HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5"
                                     Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="PART_Thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Switch" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

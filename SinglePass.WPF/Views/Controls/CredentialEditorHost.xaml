<UserControl
    x:Class="SinglePass.WPF.Views.Controls.CredentialEditorHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SinglePass.WPF.Controls"
    Visibility="Collapsed"
    ClipToBounds="True"
    Focusable="True"
    KeyboardNavigation.TabNavigation="Cycle"
    KeyboardNavigation.ControlTabNavigation="Cycle"
    SizeChanged="Host_SizeChanged">
    <Grid>
        <Border x:Name="Backdrop" Background="Black" Opacity="0" />
        <Canvas>
            <Grid x:Name="CardPanel">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CardOffset" />
                </Grid.RenderTransform>
                <controls:PrerenderedShadow x:Name="CardShadow" Opacity="0" IsHitTestVisible="False">
                    <controls:PrerenderedShadow.RenderTransform>
                        <TranslateTransform Y="5" />
                    </controls:PrerenderedShadow.RenderTransform>
                </controls:PrerenderedShadow>
                <Border Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="SurfaceScale" />
                    </Border.RenderTransform>
                </Border>
                <Decorator x:Name="CardContent">
                    <Decorator.Clip>
                        <RectangleGeometry x:Name="ContentClip" />
                    </Decorator.Clip>
                </Decorator>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>

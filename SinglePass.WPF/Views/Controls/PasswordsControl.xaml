<UserControl
    x:Class="SinglePass.WPF.Views.Controls.PasswordsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="clr-namespace:SinglePass.WPF.Views.Controls"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:SinglePass.WPF.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization"
    xmlns:settings="clr-namespace:SinglePass.WPF.Settings"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    d:DataContext="{x:Static vm:PasswordsViewModel.DesignTimeInstance}"
    IsVisibleChanged="UserControl_IsVisibleChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SortCheckVisibility" />
        <conv:CredentialGroupHeaderConverter x:Key="CredentialGroupHeaderConverter" />
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <ContextMenu x:Key="PasswordItemContextMenu">
            <MenuItem Command="{Binding Data.EditCommand, Source={StaticResource Proxy}}" Header="{Binding [Edit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <MenuItem Command="{Binding Data.DeleteCommand, Source={StaticResource Proxy}}" Header="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        </ContextMenu>
        <Style x:Key="CredentialListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
            <Setter Property="ContextMenu" Value="{StaticResource PasswordItemContextMenu}" />
            <Setter Property="MinHeight" Value="50" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Data.PasswordListPaneWidth, Source={StaticResource Proxy}, Mode=TwoWay}" MinWidth="190" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="{Binding Data.DetailsPaneWidth, Source={StaticResource Proxy}, Mode=TwoWay}" MinWidth="225" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchTextBox"
                    AutomationProperties.Name="{Binding [Search], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewKeyDown">
                            <i:InvokeCommandAction Command="{Binding HandleSearchKeyCommand}" PassEventArgsToCommand="True" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <TextBlock
                    Margin="{Binding Padding, ElementName=SearchTextBox}"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextControlPlaceholderForeground}"
                    IsHitTestVisible="False"
                    Text="{Binding [Search], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="8,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{Binding [SortBy], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    ToolTip="{Binding [SortBy], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    Click="SortButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom" DataContext="{Binding Data, Source={StaticResource Proxy}}">
                            <MenuItem Command="{Binding SortByCommand}" CommandParameter="{x:Static settings:SortType.Name}"
                                      Header="{Binding [Name], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE73E;"
                                               Visibility="{Binding Data.SortByName, Source={StaticResource Proxy}, Converter={StaticResource SortCheckVisibility}}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding SortByCommand}" CommandParameter="{x:Static settings:SortType.Created}"
                                      Header="{Binding [Created], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE73E;"
                                               Visibility="{Binding Data.SortByCreated, Source={StaticResource Proxy}, Converter={StaticResource SortCheckVisibility}}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding SortByCommand}" CommandParameter="{x:Static settings:SortType.Modified}"
                                      Header="{Binding [Modified], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE73E;"
                                               Visibility="{Binding Data.SortByModified, Source={StaticResource Proxy}, Converter={StaticResource SortCheckVisibility}}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Command="{Binding OrderByCommand}" CommandParameter="{x:Static settings:OrderType.Descending}"
                                      AutomationProperties.Name="{Binding Header.Text, RelativeSource={RelativeSource Self}}">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [NewestFirst], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Data.SortByName, Source={StaticResource Proxy}}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Descending], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </MenuItem.Header>
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE73E;"
                                               Visibility="{Binding Data.IsDescending, Source={StaticResource Proxy}, Converter={StaticResource SortCheckVisibility}}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding OrderByCommand}" CommandParameter="{x:Static settings:OrderType.Ascending}"
                                      AutomationProperties.Name="{Binding Header.Text, RelativeSource={RelativeSource Self}}">
                                <MenuItem.Header>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [OldestFirst], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Data.SortByName, Source={StaticResource Proxy}}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [Ascending], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </MenuItem.Header>
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE73E;"
                                               Visibility="{Binding Data.IsAscending, Source={StaticResource Proxy}, Converter={StaticResource SortCheckVisibility}}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5" StrokeLineJoin="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 5,3 V 17 M 2,14 L 5,17 L 8,14 M 11,4 H 19 M 11,9 H 17 M 11,14 H 15" />
                </Button>
                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{Binding [NewItem], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE710;" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding [NewItem], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="0,8">
                <ListView
                    x:Name="CredentialsListBox"
                    ItemContainerStyle="{StaticResource CredentialListViewItem}"
                    ItemsSource="{Binding GroupedCredentials}"
                    IsSynchronizedWithCurrentItem="False"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedCredentialVM, UpdateSourceTrigger=PropertyChanged}"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                    VirtualizingPanel.ScrollUnit="Pixel">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="10,12,10,4" FontSize="12" FontWeight="SemiBold" Opacity="0.72">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource CredentialGroupHeaderConverter}" Mode="OneWay">
                                                <Binding Path="Name" />
                                                <Binding Path="Culture" Source="{x:Static loc:LocalizationManager.Instance}" />
                                                <Binding Path="[NoDate]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Image Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Source="{Binding FavIcon32, TargetNullValue={StaticResource DefaultFavIcon}}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Text="{Binding NameFieldVM.Value}" ToolTip="{Binding NameFieldVM.Value}" />
                                    <TextBlock Margin="0,2,0,0" Opacity="0.72" TextTrimming="CharacterEllipsis"
                                               Text="{Binding WebsiteDomain, TargetNullValue=—}" ToolTip="{Binding WebsiteDomain}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding [NoCredentials], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasLoadedCredentials}" Value="True" />
                                        <Condition Binding="{Binding DisplayedCredentials.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <GridSplitter
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            ResizeBehavior="PreviousAndNext" />
        <ct:CredentialsDetailsControl x:Name="CredentialsDetailsControl" Grid.Column="2" />
    </Grid>
</UserControl>

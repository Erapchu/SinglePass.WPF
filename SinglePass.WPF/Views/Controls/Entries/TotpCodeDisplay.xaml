<UserControl
    x:Class="SinglePass.WPF.Views.Controls.Entries.TotpCodeDisplay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" Focusable="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="CodeText" FontFamily="Consolas"
                   FontSize="{StaticResource PasswordFontSize}" VerticalAlignment="Center" />
        <Grid x:Name="Countdown" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center">
            <Ellipse Stroke="{Binding Stroke, ElementName=ProgressArc}" StrokeThickness="2" Opacity="0.2" />
            <Path x:Name="ProgressArc" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </Grid>
    </StackPanel>
</UserControl>

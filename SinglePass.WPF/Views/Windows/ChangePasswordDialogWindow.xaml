<Window
    x:Class="SinglePass.WPF.Views.Windows.ChangePasswordDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization"
    Title="{Binding [ChangePassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
    Width="430"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    UseLayoutRounding="True"
    FocusManager.FocusedElement="{Binding ElementName=CurrentPasswordBox}">
    <Window.Resources>
        <Style x:Key="PasswordInput" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
            <Setter Property="FontFamily" Value="{StaticResource PasswordFontFamily}" />
            <Setter Property="FontSize" Value="{StaticResource PasswordFontSize}" />
            <Setter Property="MaxLength" Value="32" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PasswordFields" Margin="0,0,8,0">
                <Label Padding="0,0,0,6" Content="{Binding [CurrentPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                       Target="{Binding ElementName=CurrentPasswordBox}" />
                <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource PasswordInput}" PasswordChanged="PasswordInput_Changed" />
                <Label Margin="0,10,0,0" Padding="0,0,0,6" Content="{Binding [NewPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                       Target="{Binding ElementName=NewPasswordBox}" />
                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PasswordInput}" PasswordChanged="PasswordInput_Changed" />
                <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button x:Name="SaveButton" Margin="0,0,8,0" Click="Save_Click" IsDefault="True" IsEnabled="False"
                    Content="{Binding [Save], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button x:Name="CancelButton" IsCancel="True"
                    Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Window>

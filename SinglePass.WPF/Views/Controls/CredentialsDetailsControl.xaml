<UserControl
    x:Class="SinglePass.WPF.Views.Controls.CredentialsDetailsControl"
    x:Name="Details"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <conv:BooleanTFConverter x:Key="InverseBooleanConverter" TrueValue="False" FalseValue="True" />
        <DataTemplate x:Key="GroupOptionTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" FontSize="14"
                           Style="{StaticResource SymbolText}" Text="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Name}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                    <Setter Property="Text" Value="{Binding [NoPasswordGroup], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border x:Name="CardBorder" Padding="0">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding SelectedCredentialVM}" Value="{x:Null}" />
                            <Condition Binding="{Binding IsEditing, ElementName=Details}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="16,16,16,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button x:Name="EditButton" Margin="4,0" Padding="6,4" Click="EditButton_Click"
                            IsEnabled="{Binding CanEditCredential}"
                            AutomationProperties.Name="{Binding [Edit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [Edit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE70F;" />
                    </Button>
                    <Button x:Name="DeleteButton" Padding="6,4" Click="DeleteButton_Click" IsEnabled="{Binding CanEditCredential}"
                            AutomationProperties.Name="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <Image x:Name="CredentialIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,8,0"
                       IsVisibleChanged="CredentialIcon_IsVisibleChanged">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{Binding SelectedCredentialVM.FavIcon, TargetNullValue={StaticResource DefaultFavIcon}}" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAdding}" Value="True" />
                                        <Condition Binding="{Binding IsEditing, ElementName=Details}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Source" Value="{StaticResource DefaultFavIcon}" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedCredentialVM.IsSshKey}" Value="True" />
                                        <Condition Binding="{Binding IsEditing, ElementName=Details}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding DisplayedDraft.IsSshKey, ElementName=Details}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock DockPanel.Dock="Left" Width="32" Margin="0,0,8,0" FontSize="24" TextAlignment="Center"
                           VerticalAlignment="Center" Text="&#xE756;">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding SelectedCredentialVM.IsSshKey}" Value="True" />
                                        <Condition Binding="{Binding IsEditing, ElementName=Details}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding DisplayedDraft.IsSshKey, ElementName=Details}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedCredentialVM.NameFieldVM.Value}"
                           Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <TextBox x:Name="NameEditBox" MaxLength="200" MinHeight="32" VerticalAlignment="Center"
                         AutomationProperties.Name="{Binding [Name], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                         Text="{Binding DisplayedDraft.NameFieldVM.Value, ElementName=Details, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                         IsVisibleChanged="NameEditBox_IsVisibleChanged"
                         IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBooleanConverter}}"
                         Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" Margin="16,0,16,16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel Margin="0,0,4,0">
                    <StackPanel Visibility="{Binding SelectedCredentialVM.IsLogin, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Label Padding="0,0,0,6" Content="{Binding [Login], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=LoginTextBox}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                                Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.LoginFieldVM.Value}"
                                AutomationProperties.Name="{Binding [CopyLogin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyLogin], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                            <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                        </Button>
                        <TextBox x:Name="LoginTextBox" IsReadOnly="True" Text="{Binding SelectedCredentialVM.LoginFieldVM.Value, Mode=OneWay}" />
                    </DockPanel>
                    <TextBlock Margin="0,12,0,6" Text="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Margin="4,0,0,0" Padding="6,4" IsChecked="{Binding IsPasswordVisible}"
                                          AutomationProperties.Name="{Binding [ShowHidePassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHidePassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                                            <Setter Property="Text" Value="&#xE890;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                    <Setter Property="Text" Value="&#xED1A;" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ToggleButton>
                            <Button Margin="4,0,0,0" Padding="6,4"
                                    Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.PasswordFieldVM.Value}"
                                    AutomationProperties.Name="{Binding [CopyPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPassword], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                            </Button>
                        </StackPanel>
                        <Grid>
                            <TextBox IsReadOnly="True" AutomationProperties.Name="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                     FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                                     Text="{Binding SelectedCredentialVM.PasswordFieldVM.Value, Mode=OneWay}"
                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <PasswordBox FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}" x:Name="PasswordFieldBox" Focusable="False" IsHitTestVisible="False"
                                         AutomationProperties.Name="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                         Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </Grid>
                    </DockPanel>
                    <StackPanel x:Name="TotpDisplay" Margin="0,12,0,0"
                                DataContext="{Binding SelectedCredentialVM.Totp}"
                                DataContextChanged="TotpDisplay_DataContextChanged"
                                Loaded="TotpDisplay_Loaded"
                                IsVisibleChanged="TotpDisplay_IsVisibleChanged" Unloaded="TotpDisplay_Unloaded">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Margin="0,0,0,6"
                                   Text="{Binding [TotpCode], Source={x:Static loc:LocalizationManager.Instance}}" />
                        <DockPanel>
                            <Button x:Name="CopyTotpButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4"
                                    Command="{Binding DataContext.CopyTotpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    AutomationProperties.Name="{Binding [CopyTotp], Source={x:Static loc:LocalizationManager.Instance}}"
                                    ToolTip="{Binding [CopyTotp], Source={x:Static loc:LocalizationManager.Instance}}">
                                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                            </Button>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TotpCode" FontFamily="Consolas"
                                           FontSize="{StaticResource PasswordFontSize}" VerticalAlignment="Center" />
                                <Grid x:Name="TotpCountdown" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{Binding Stroke, ElementName=TotpProgressArc}" StrokeThickness="2" Opacity="0.2" />
                                    <Path x:Name="TotpProgressArc" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel x:Name="WebsiteRow" Visibility="{Binding SelectedCredentialVM.HasWebsite, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Website], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=WebsiteLink}" />
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Hyperlink x:Name="WebsiteLink" Command="{Binding OpenInBrowserCommand}"
                                       CommandParameter="{Binding SelectedCredentialVM.Website.Address}">
                                <Hyperlink.Style>
                                    <Style TargetType="Hyperlink">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Setter Property="TextDecorations" Value="{x:Null}" />
                                        <Style.Triggers>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsEnabled" Value="True" />
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                </MultiTrigger.Conditions>
                                                <Setter Property="TextDecorations" Value="Underline" />
                                            </MultiTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Hyperlink.Style>
                                <Run Text="{Binding SelectedCredentialVM.Website.Prefix, Mode=OneWay}" /><Run Text="{Binding SelectedCredentialVM.Website.Host, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /><Run Text="{Binding SelectedCredentialVM.Website.Suffix, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedCredentialVM.IsSshKey, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel Visibility="{Binding SelectedCredentialVM.HasSshPublicKey, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Label Padding="0,0,0,6" Content="{Binding [PublicKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PublicKeyTextBox}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4" VerticalAlignment="Top"
                                        Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.SshPublicKey}"
                                        AutomationProperties.Name="{Binding [CopyPublicKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPublicKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                                </Button>
                                <TextBox x:Name="PublicKeyTextBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                                         MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                         Text="{Binding SelectedCredentialVM.SshPublicKey, Mode=OneWay}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SelectedCredentialVM.HasSshKeyInfo, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Fingerprint], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=FingerprintTextBox}" />
                            <TextBox x:Name="FingerprintTextBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas">
                                <TextBox.Text>
                                    <MultiBinding Mode="OneWay" StringFormat="{}{0} ({1})">
                                        <Binding Path="SelectedCredentialVM.SshKeyInfo.Fingerprint" />
                                        <Binding Path="SelectedCredentialVM.SshKeyInfo.KeyType" />
                                    </MultiBinding>
                                </TextBox.Text>
                            </TextBox>
                        </StackPanel>
                        <StackPanel Visibility="{Binding SelectedCredentialVM.HasSshPrivateKey, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Margin="0,12,0,6" Text="{Binding [PrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ToggleButton Margin="4,0,0,0" Padding="6,4" IsChecked="{Binding IsPrivateKeyVisible}"
                                                  AutomationProperties.Name="{Binding [ShowHidePrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHidePrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                                                    <Setter Property="Text" Value="&#xE890;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPrivateKeyVisible}" Value="True">
                                                            <Setter Property="Text" Value="&#xED1A;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                    <Button Margin="4,0,0,0" Padding="6,4"
                                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.SshPrivateKey}"
                                            AutomationProperties.Name="{Binding [CopyPrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                                    </Button>
                                    <Button Margin="4,0,0,0" Padding="6,4" Click="SavePrivateKey_Click"
                                            AutomationProperties.Name="{Binding [SavePrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [SavePrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74E;" />
                                    </Button>
                                </StackPanel>
                                <Grid>
                                    <TextBox IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="{Binding [PrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                             Text="{Binding SelectedCredentialVM.SshPrivateKey, Mode=OneWay}"
                                             Visibility="{Binding IsPrivateKeyVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                                             Text="&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;"
                                             Visibility="{Binding IsPrivateKeyVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </Grid>
                            </DockPanel>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding [SshKeyEncrypted], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                       Visibility="{Binding SelectedCredentialVM.IsSshKeyEncrypted, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding SelectedCredentialVM.HasSshPassphrase, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Margin="0,12,0,6" Text="{Binding [Passphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <ToggleButton Margin="4,0,0,0" Padding="6,4" IsChecked="{Binding IsPassphraseVisible}"
                                                  AutomationProperties.Name="{Binding [ShowHidePassphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHidePassphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                                                    <Setter Property="Text" Value="&#xE890;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPassphraseVisible}" Value="True">
                                                            <Setter Property="Text" Value="&#xED1A;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                    <Button Margin="4,0,0,0" Padding="6,4"
                                            Command="{Binding CopyToClipboardCommand}" CommandParameter="{Binding SelectedCredentialVM.SshPassphrase}"
                                            AutomationProperties.Name="{Binding [CopyPassphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPassphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                                    </Button>
                                </StackPanel>
                                <Grid>
                                    <TextBox IsReadOnly="True" AutomationProperties.Name="{Binding [Passphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                                             Text="{Binding SelectedCredentialVM.SshPassphrase, Mode=OneWay}"
                                             Visibility="{Binding IsPassphraseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                                             Text="&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;"
                                             Visibility="{Binding IsPassphraseVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </Grid>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Visibility="{Binding SelectedCredentialVM.OtherFieldVM.HasText, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Other], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=OtherTextBox}" />
                        <TextBox x:Name="OtherTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                 Text="{Binding SelectedCredentialVM.OtherFieldVM.Value, Mode=OneWay}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SelectedCredentialVM.AdditionalFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <Label Padding="0,0,0,6" Content="{Binding Name}" Target="{Binding ElementName=FieldValue}" />
                                    <TextBox x:Name="FieldValue" IsReadOnly="True" Text="{Binding Value, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Label DockPanel.Dock="Left" Padding="0,0,8,0" VerticalAlignment="Center"
                               Content="{Binding [PasswordGroupLabel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <ContentControl Content="{Binding CurrentGroup}" ContentTemplate="{StaticResource GroupOptionTemplate}"
                                        VerticalAlignment="Center" Focusable="False" />
                    </DockPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Mode="OneWay">
                                <MultiBinding.Converter>
                                    <conv:LocalizedFormatConverter />
                                </MultiBinding.Converter>
                                <Binding Path="[ModifiedFormatted]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                <Binding Path="SelectedCredentialVM.LastModifiedTime" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Mode="OneWay">
                                <MultiBinding.Converter>
                                    <conv:LocalizedFormatConverter />
                                </MultiBinding.Converter>
                                <Binding Path="[CreatedFormatted]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                <Binding Path="SelectedCredentialVM.CreationTime" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Expander Margin="0,12,0,0" DataContext="{Binding SelectedCredentialVM}"
                              AutomationProperties.Name="{Binding Text, ElementName=PasswordHistoryTitle}"
                              DataContextChanged="PasswordHistory_DataContextChanged"
                              IsVisibleChanged="PasswordHistory_IsVisibleChanged">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0" Style="{StaticResource SymbolText}" Text="&#xE81C;" />
                                <TextBlock x:Name="PasswordHistoryTitle" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Mode="OneWay" StringFormat="{}{0} ({1})">
                                            <Binding Path="[PasswordHistory]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                            <Binding Path="Model.Login.PasswordHistory.Count" FallbackValue="0" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Expander.Header>
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Model.Login.PasswordHistory.Count, FallbackValue=0}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <ItemsControl>
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                                            <Setter Property="ItemsSource" Value="{Binding Model.Login.PasswordHistory}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ToggleButton x:Name="RevealHistoryEntry" Margin="4,0,0,0" Padding="6,4"
                                                          AutomationProperties.Name="{Binding [ShowHidePassword], Source={x:Static loc:LocalizationManager.Instance}}"
                                                          ToolTip="{Binding [ShowHidePassword], Source={x:Static loc:LocalizationManager.Instance}}">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
                                                            <Setter Property="Text" Value="&#xE890;" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsChecked, ElementName=RevealHistoryEntry}" Value="True">
                                                                    <Setter Property="Text" Value="&#xED1A;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </ToggleButton>
                                            <Button Margin="4,0,0,0" Padding="6,4" CommandParameter="{Binding Password}"
                                                    Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    AutomationProperties.Name="{Binding [CopyPassword], Source={x:Static loc:LocalizationManager.Instance}}"
                                                    ToolTip="{Binding [CopyPassword], Source={x:Static loc:LocalizationManager.Instance}}">
                                                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding ChangedAtLocal, StringFormat={}{0:dd-MM-yyyy, HH:mm:ss}}" />
                                            <TextBlock FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                                                       TextWrapping="Wrap" AutomationProperties.Name="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChecked, ElementName=RevealHistoryEntry}" Value="True">
                                                                <Setter Property="Text" Value="{Binding Password, Mode=OneWay}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="EditScrollViewer" Grid.Row="1" Margin="16,0,16,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBooleanConverter}}"
                          Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="0,0,4,0">
                    <StackPanel Visibility="{Binding DisplayedDraft.IsLogin, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <Label Padding="0,0,0,6" Content="{Binding [Login], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=LoginEditBox}" />
                    <TextBox x:Name="LoginEditBox" MaxLength="200"
                             Text="{Binding DisplayedDraft.LoginFieldVM.Value, ElementName=Details, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PasswordEditBox}" />
                    <TextBox x:Name="PasswordEditBox" MaxLength="200"
                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             Text="{Binding DisplayedDraft.PasswordFieldVM.Value, ElementName=Details, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel x:Name="EditTotpDisplay" Margin="0,12,0,0"
                                Visibility="{Binding DisplayedDraft.ShowCurrentTotp, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                                DataContext="{Binding DisplayedDraft.Totp, ElementName=Details}"
                                DataContextChanged="TotpDisplay_DataContextChanged"
                                Loaded="TotpDisplay_Loaded"
                                IsVisibleChanged="TotpDisplay_IsVisibleChanged" Unloaded="TotpDisplay_Unloaded">
                        <TextBlock Margin="0,0,0,6"
                                   Text="{Binding [TotpCode], Source={x:Static loc:LocalizationManager.Instance}}" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Margin="4,0,0,0" Padding="6,4" Click="ReplaceTotp_Click"
                                        AutomationProperties.Name="{Binding [ReplaceTotp], Source={x:Static loc:LocalizationManager.Instance}}"
                                        ToolTip="{Binding [ReplaceTotp], Source={x:Static loc:LocalizationManager.Instance}}">
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE70F;" />
                                </Button>
                                <Button Margin="4,0,0,0" Padding="6,4" Click="RemoveTotp_Click"
                                        AutomationProperties.Name="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}}"
                                        ToolTip="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}}">
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74D;" />
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="EditTotpCode" FontFamily="Consolas"
                                           FontSize="{StaticResource PasswordFontSize}" VerticalAlignment="Center" />
                                <Grid x:Name="EditTotpCountdown" Width="16" Height="16" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{Binding Stroke, ElementName=EditTotpProgressArc}" StrokeThickness="2" Opacity="0.2" />
                                    <Path x:Name="EditTotpProgressArc" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding DisplayedDraft.RemoveTotp, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Text="{Binding [TotpRemovalPending], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <StackPanel
                                Visibility="{Binding DisplayedDraft.ShowTotpSetup, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Label Margin="0,12,0,0" Padding="0,0,0,6" Target="{Binding ElementName=TotpSetupBox}"
                               Content="{Binding [TotpSetup], Source={x:Static loc:LocalizationManager.Instance}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Click="PasteTotpQr_Click"
                                    IsEnabled="{Binding DisplayedDraft.RemoveTotp, ElementName=Details, Converter={StaticResource InverseBooleanConverter}}"
                                    Content="{Binding [PasteTotpQr], Source={x:Static loc:LocalizationManager.Instance}}" />
                            <PasswordBox x:Name="TotpSetupBox" MaxLength="4096"
                                     DataContext="{Binding DisplayedDraft, ElementName=Details}" DataContextChanged="TotpSetupBox_DataContextChanged"
                                     PasswordChanged="TotpSetupBox_PasswordChanged"
                                     IsEnabled="{Binding RemoveTotp, Converter={StaticResource InverseBooleanConverter}}" />
                        </DockPanel>
                        <TextBlock x:Name="TotpQrStatus" Margin="0,6,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding DisplayedDraft.HasInvalidTotp, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding [InvalidTotp], Source={x:Static loc:LocalizationManager.Instance}}" />
                    </StackPanel>
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Website], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=WebsiteEditBox}" />
                    <TextBox x:Name="WebsiteEditBox" MaxLength="5000" TextWrapping="Wrap"
                             Text="{Binding DisplayedDraft.SiteFieldVM.Value, ElementName=Details, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding DisplayedDraft.IsSshKey, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <WrapPanel Margin="0,0,0,6">
                            <Button Margin="0,0,8,6" Click="ImportSshKey_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8E5;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding [ImportSshKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,8,6" Click="GenerateSshKey_Click"
                                    Visibility="{Binding DisplayedDraft.HasSshPrivateKey, ElementName=Details, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE710;" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding [GenerateSshKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="SshKeyStatus" Margin="0,0,0,6" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Label Padding="0,0,0,6" Content="{Binding [PrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PrivateKeyEditBox}" />
                        <TextBox x:Name="PrivateKeyEditBox" MaxLength="20000" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Consolas" MinHeight="64" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                                 DataContext="{Binding DisplayedDraft, ElementName=Details}" DataContextChanged="PrivateKeyEditBox_DataContextChanged"
                                 Text="{Binding SshPrivateKey, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding [SshKeyEncrypted], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                                   Visibility="{Binding DisplayedDraft.IsSshKeyEncrypted, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
                        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Passphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PassphraseEditBox}" />
                        <TextBox x:Name="PassphraseEditBox" MaxLength="1000"
                                 FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                                 Text="{Binding DisplayedDraft.SshPassphrase, ElementName=Details, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [PublicKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PublicKeyEditBox}" />
                        <TextBox x:Name="PublicKeyEditBox" MaxLength="20000" TextWrapping="Wrap" FontFamily="Consolas"
                                 MaxHeight="120" VerticalScrollBarVisibility="Auto"
                                 Text="{Binding DisplayedDraft.SshPublicKey, ElementName=Details, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding DisplayedDraft.HasSshKeyInfo, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock.Text>
                                <MultiBinding Mode="OneWay" StringFormat="{}{0} ({1})">
                                    <Binding Path="DisplayedDraft.SshKeyInfo.Fingerprint" ElementName="Details" />
                                    <Binding Path="DisplayedDraft.SshKeyInfo.KeyType" ElementName="Details" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Other], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=OtherEditBox}" />
                    <TextBox x:Name="OtherEditBox" AcceptsReturn="True" MaxLength="5000" TextWrapping="Wrap"
                             Text="{Binding DisplayedDraft.OtherFieldVM.Value, ElementName=Details, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl ItemsSource="{Binding DisplayedDraft.AdditionalFields, ElementName=Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <Label Padding="0,0,0,6" Content="{Binding Name}" Target="{Binding ElementName=FieldEditBox}" />
                                    <TextBox x:Name="FieldEditBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Label DockPanel.Dock="Left" Padding="0,0,8,0" VerticalAlignment="Center"
                               Target="{Binding ElementName=GroupSelector}"
                               Content="{Binding [PasswordGroupLabel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <ComboBox x:Name="GroupSelector" MinWidth="110" MaxWidth="220"
                                  ItemsSource="{Binding GroupOptions}"
                                  ItemTemplate="{StaticResource GroupOptionTemplate}"
                                  SelectedItem="{Binding DraftGroup, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="EditorFooter" Grid.Row="2"
                  Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="0,0,7,7"
                        IsHitTestVisible="False" />
                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Padding="25,20">
                    <UniformGrid Rows="1" Columns="2">
                        <Button Margin="0,0,5,0" MinHeight="36" HorizontalAlignment="Stretch"
                                Command="{Binding SaveEditCommand}" Style="{DynamicResource AccentButtonStyle}"
                                Content="{Binding [Save], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <Button Margin="5,0,0,0" MinHeight="36" HorizontalAlignment="Stretch"
                                Command="{Binding CancelEditCommand}"
                                Content="{Binding [CancelEdit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </UniformGrid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

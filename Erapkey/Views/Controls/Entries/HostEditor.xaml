<UserControl
    x:Class="Erapkey.Views.Controls.Entries.HostEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctl="clr-namespace:Erapkey.Views.Controls"
    xmlns:evm="clr-namespace:Erapkey.ViewModels.Entries"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core"
    d:DataContext="{d:DesignInstance Type=evm:HostViewModel}"
    mc:Ignorable="d"
    IsTabStop="False" Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary Source="EntryResources.xaml" />
    </UserControl.Resources>
    <!-- Editor of an SSH host draft. DataContext: HostViewModel of the draft. -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <Label Padding="0,0,0,6" Content="{Binding [Hostname], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=HostnameEditBox}" />
                <TextBox x:Name="HostnameEditBox" MaxLength="255" Text="{Binding Hostname, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <Label Padding="0,0,0,6" Content="{Binding [Port], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PortEditBox}" />
                <TextBox x:Name="PortEditBox" MaxLength="5" Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Grid>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Text="{Binding [PortInvalid], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                   Visibility="{Binding IsPortInvalid, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Username], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=UsernameEditBox}" />
        <TextBox x:Name="UsernameEditBox" MaxLength="255" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [SshKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=SshKeySelector}" />
        <ComboBox x:Name="SshKeySelector" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding DataContext.SshKeyOptions, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                  SelectedValuePath="Id" SelectedValue="{Binding SshKeyId, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding KeyType}" />
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                    </DockPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding [HostSshKeyHint], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
    </StackPanel>
</UserControl>

<UserControl
    x:Class="Erapkey.Desktop.Views.Controls.AppearanceControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Erapkey.Desktop.Controls"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core"
    xmlns:settings="clr-namespace:Erapkey.Desktop.Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
            <Border Margin="0,0,0,8" Style="{StaticResource Card}">
                <DockPanel>
                    <ComboBox x:Name="ThemeSelector" DockPanel.Dock="Right" MinWidth="164" Margin="12,0,0,0" VerticalAlignment="Center"
                              SelectedValue="{Binding ThemeMode, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{Binding [System], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:AppTheme.Inherit}" />
                        <ComboBoxItem Content="{Binding [Light], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:AppTheme.Light}" />
                        <ComboBoxItem Content="{Binding [Dark], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Tag="{x:Static settings:AppTheme.Dark}" />
                    </ComboBox>
                    <Label Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Content="{Binding [Theme], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=ThemeSelector}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <controls:ToggleSwitch x:Name="AnimationsToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.LabeledBy="{Binding ElementName=AnimationsLabel}"
                                           IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}" />
                    <Label x:Name="AnimationsLabel" Padding="0" VerticalAlignment="Center" FontWeight="SemiBold"
                           Target="{Binding ElementName=AnimationsToggle}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="{Binding [Animations], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </Label>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

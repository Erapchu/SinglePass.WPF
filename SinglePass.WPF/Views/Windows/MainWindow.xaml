<Window
    x:Class="SinglePass.WPF.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:SinglePass.WPF.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:SinglePass.WPF.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    Title="{x:Static helpers:Constants.AppName}"
    Icon="/SinglePass.WPF;component/Resources/pass-man.ico"
    Width="800"
    Height="550"
    MinWidth="620"
    MinHeight="300"
    d:DataContext="{x:Static vm:MainWindowViewModel.DesignTimeInstance}"
    Closed="Window_Closed"
    Closing="Window_Closing"
    IsVisibleChanged="Window_IsVisibleChanged"
    Loaded="Window_Loaded"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    mc:Ignorable="d">
    <Window.Resources>
        <Style x:Key="NavigationListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
            <EventSetter Event="PreviewMouseDown" Handler="ListBoxItem_PreviewMouseDown" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="DockPanel.Dock" Value="Top" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DockAtBottom}" Value="True">
                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="NavigationItemTemplate" DataType="{x:Type vm:NavigationItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SymbolText}" Text="{Binding Glyph}" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding Name}" TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static controls:SettingsControl.OpenCloudSyncCommand}" Executed="OpenCloudSync_Executed" />
    </Window.CommandBindings>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListView
            Margin="0,0,8,0"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource NavigationListViewItem}"
            ItemTemplate="{StaticResource NavigationItemTemplate}"
            ItemsSource="{Binding NavigationItems}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedNavigationItem}"
            SelectionChanged="Navigation_SelectionChanged">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
        <DockPanel Grid.Column="1" ClipToBounds="True">
            <Grid x:Name="SettingsHeader" DockPanel.Dock="Top" Margin="8,4,8,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="SettingsBreadcrumbButton"
                    Height="39"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{Binding [Settings], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="SettingsBreadcrumbButton_Click"
                    Visibility="{Binding Visibility, ElementName=CloudSyncBreadcrumb}" />
                <TextBlock
                    x:Name="SettingsHeading"
                    Height="39"
                    Padding="2,3,4,0"
                    VerticalAlignment="Top"
                    FontSize="24"
                    FontWeight="SemiBold"
                    IsHitTestVisible="False"
                    Text="{Binding [Settings], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=CloudSyncBreadcrumb}" Value="Visible">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="AutomationProperties.HeadingLevel" Value="None" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DockPanel x:Name="CloudSyncBreadcrumb" Grid.Column="1" Visibility="Collapsed">
                    <Grid DockPanel.Dock="Left" Height="39" Margin="8,0,12,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE76C;" />
                    </Grid>
                    <TextBlock
                        Padding="0,3,0,0"
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="{Binding [CloudSync], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </Grid>
            <ContentControl
                x:Name="NavigationContent"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Content" Value="{Binding SelectedNavigationItem.Content}" />
                    </Style>
                </ContentControl.Style>
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="NavigationOffset" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </DockPanel>
        <Border
            x:Name="StatusBanner"
            Grid.Column="1"
            Margin="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Padding="14,8"
            AutomationProperties.LiveSetting="Polite"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            IsHitTestVisible="False"
            Style="{StaticResource Card}"
            Visibility="Collapsed">
            <TextBlock x:Name="StatusText" />
        </Border>
    </Grid>
</Window>

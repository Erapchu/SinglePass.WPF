<UserControl
    x:Class="Erapkey.Views.Controls.AboutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Erapkey.Views.Controls"
    xmlns:services="clr-namespace:Erapkey.Services"
    xmlns:toggle="clr-namespace:Erapkey.Controls"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8">
        <Border Margin="0,0,0,8" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Erapkey" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="{Binding [AppVersion], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <Run Text=" " /><Run Text="{x:Static controls:AboutControl.AppVersion}" />
                </TextBlock>
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                           Text="{Binding [AboutDescription], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://github.com/Erapchu/Erapkey" RequestNavigate="OpenLink">
                        <Run Text="{Binding [AboutProjectLink], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                    <Run Text="{Binding [AboutFounder], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    <Run Text=" " /><Hyperlink NavigateUri="https://github.com/Erapchu" RequestNavigate="OpenLink">Andrey Nasonov</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold"
                           Text="{Binding [Updates], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="{Binding StatusText, Mode=OneWay}" />
                <StackPanel Margin="0,12,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSupported}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <DockPanel>
                        <toggle:ToggleSwitch x:Name="AutoUpdateToggle" DockPanel.Dock="Right" Margin="12,0,0,0"
                                             VerticalAlignment="Center"
                                             AutomationProperties.LabeledBy="{Binding ElementName=AutoUpdateLabel}"
                                             IsChecked="{Binding AutoCheck, Mode=TwoWay}" />
                        <Label x:Name="AutoUpdateLabel" Padding="0" VerticalAlignment="Center"
                               Target="{Binding ElementName=AutoUpdateToggle}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="{Binding [UpdateCheckAutomatically], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        </Label>
                    </DockPanel>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <Button Command="{Binding CheckCommand}"
                                Content="{Binding [UpdateCheckNow], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static services:UpdateState.ReadyToRestart}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding RestartCommand}"
                                Content="{Binding [UpdateRestart], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static services:UpdateState.ReadyToRestart}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

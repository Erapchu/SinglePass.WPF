<UserControl
    x:Class="SinglePass.WPF.Views.Controls.CloudSyncControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cloud="clr-namespace:SinglePass.WPF.Cloud.Enums"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    d:DataContext="{x:Static vm:CloudSyncViewModel.DesignTimeInstance}"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="CloudAccountTemplate">
            <Border Margin="8" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Google Drive" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static cloud:CloudType.YandexDisk}">
                                        <Setter Property="Text" Value="{Binding [YandexDisk], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button
                        HorizontalAlignment="Left"
                        Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Type}"
                        Content="{Binding [SignIn], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                        IsEnabled="{Binding CanSignIn}"
                        Style="{DynamicResource AccentButtonStyle}"
                        Visibility="{Binding IsConnected, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="{Binding [YandexDiskOAuthNotConfigured], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                        TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsConnected}" Value="False" />
                                            <Condition Binding="{Binding CanSignIn}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Text="{Binding [Loading], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                            Visibility="{Binding FetchingUserInfo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <StackPanel
                            Margin="0,0,0,12"
                            Orientation="Horizontal"
                            Visibility="{Binding FetchingUserInfo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <Ellipse Width="36" Height="36">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ProfileImage}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding UserName}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <WrapPanel>
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.TransferInProgress, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding FetchingUserInfo}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <Button
                                Margin="0,0,8,4"
                                Command="{Binding DataContext.SyncCredentialsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Type}"
                                Content="{Binding [Sync], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                            <Button
                                Margin="0,0,8,4"
                                Command="{Binding DataContext.UploadCredentialsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Type}"
                                Content="{Binding [Upload], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                            <Button
                                Margin="0,0,0,4"
                                Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Type}"
                                Content="{Binding [SignOut], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        </WrapPanel>
                        <ProgressBar
                            Height="4" Margin="0,8,0,0" IsIndeterminate="True"
                            Visibility="{Binding Transferring, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ContentControl Content="{Binding GoogleDrive}" ContentTemplate="{StaticResource CloudAccountTemplate}" />
            <ContentControl Content="{Binding YandexDisk}" ContentTemplate="{StaticResource CloudAccountTemplate}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>

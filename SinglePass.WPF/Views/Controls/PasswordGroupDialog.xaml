<UserControl
    x:Class="SinglePass.WPF.Views.Controls.PasswordGroupDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core">
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Margin="16,16,16,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Margin="0,0,0,12" Style="{StaticResource ModalHeader}" />
                <Label Padding="0,0,0,6" Target="{Binding ElementName=GroupNameTextBox}"
                       Content="{Binding [Name], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <TextBox x:Name="GroupNameTextBox" MaxLength="100" TextChanged="GroupName_TextChanged" />
                <Label Margin="0,10,0,0" Padding="0,0,0,6" Target="{Binding ElementName=IconList}"
                       Content="{Binding [GroupIcon], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <ListBox x:Name="IconList" HorizontalAlignment="Center"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="{Binding [GroupIcon], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Width" Value="40" />
                            <Setter Property="Height" Value="40" />
                            <Setter Property="Margin" Value="2" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent"
                                                BorderThickness="1" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource SymbolText}" FontSize="20" Text="{Binding Glyph}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="Footer" Grid.Row="1" Style="{StaticResource ModalFooter}">
            <UniformGrid Rows="1" Columns="2">
                <Button x:Name="SaveGroupButton" Margin="5,0" Padding="6,4" MinHeight="36" HorizontalAlignment="Stretch"
                        Click="SaveGroup_Click" IsDefault="True" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}"
                        Content="{Binding [Save], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <Button Margin="5,0" Padding="6,4" MinHeight="36" HorizontalAlignment="Stretch" Click="Cancel_Click"
                        Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            </UniformGrid>
        </ContentControl>
    </Grid>
</UserControl>

<UserControl
    x:Class="SinglePass.WPF.Views.Controls.ProcessingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core">
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Margin="16,16,16,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="HeaderText" Style="{StaticResource ModalHeader}" />
                <TextBlock x:Name="MessageText" Margin="0,8,0,0" TextWrapping="Wrap" />
                <ProgressBar Height="4" Margin="0,16,0,0" IsIndeterminate="True" />
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="Footer" Grid.Row="1" Style="{StaticResource ModalFooter}">
            <Button x:Name="CancelButton" Margin="5,0" Padding="6,4" MinHeight="36" HorizontalAlignment="Stretch"
                    Click="Cancel_Click"
                    Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        </ContentControl>
    </Grid>
</UserControl>

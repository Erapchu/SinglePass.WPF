<Window
    x:Class="SinglePass.WPF.Views.Windows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    Title="{x:Static properties:Resources.Authorize}"
    Icon="/SinglePass.WPF;component/Resources/pass-man.ico"
    Width="400"
    Height="240"
    ResizeMode="NoResize"
    d:DataContext="{x:Static vm:LoginWindowViewModel.DesignTimeInstance}"
    Activated="Window_Activated"
    Closed="Window_Closed"
    FocusManager.FocusedElement="{Binding ElementName=LoginPasswordBox}"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,6">
            <TextBlock
                DockPanel.Dock="Right"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Text="{x:Static properties:Resources.CAPSLOCKEnabled}"
                Visibility="{Binding IsCapsLockEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Label Padding="0" Content="{Binding HintText}" Target="{Binding ElementName=LoginPasswordBox}" />
        </DockPanel>
        <PasswordBox FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}" x:Name="LoginPasswordBox" Grid.Row="1" MaxLength="32" PasswordChanged="PasswordBox_PasswordChanged">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="GotFocus">
                    <i:InvokeCommandAction Command="{Binding RefreshCapsLockCommand}" />
                </i:EventTrigger>
                <i:EventTrigger EventName="KeyDown">
                    <i:InvokeCommandAction Command="{Binding RefreshCapsLockCommand}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </PasswordBox>
        <TextBlock Grid.Row="2" Margin="0,6,0,0" VerticalAlignment="Top" Text="{Binding HelperText}" TextWrapping="Wrap" />
        <ProgressBar
            Grid.Row="3"
            Height="4"
            VerticalAlignment="Bottom"
            IsIndeterminate="True"
            Visibility="{Binding Loading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <StackPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Command="{Binding LoadCredentialsCommand}"
                Content="{x:Static properties:Resources.Enter}"
                IsDefault="True"
                Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="{x:Static properties:Resources.Exit}" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

<UserControl
    x:Class="Erapkey.Views.Controls.Entries.SshKeyDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ctl="clr-namespace:Erapkey.Views.Controls"
    xmlns:evm="clr-namespace:Erapkey.ViewModels.Entries"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core"
    d:DataContext="{d:DesignInstance Type=evm:SshKeyViewModel}"
    mc:Ignorable="d"
    IsTabStop="False" Focusable="False"
    DataContextChanged="View_DataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary Source="EntryResources.xaml" />
    </UserControl.Resources>
    <!-- Read-only view of an SSH key. DataContext: SshKeyViewModel. Secrets are hidden again for every key shown. -->
    <StackPanel>
        <StackPanel Visibility="{Binding HasPublicKey, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label Padding="0,0,0,6" Content="{Binding [PublicKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=PublicKeyTextBox}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4" VerticalAlignment="Top"
                        Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                        CommandParameter="{Binding PublicKey}"
                        AutomationProperties.Name="{Binding [CopyPublicKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPublicKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                </Button>
                <TextBox x:Name="PublicKeyTextBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas"
                         MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         Text="{Binding PublicKey, Mode=OneWay}" />
            </DockPanel>
        </StackPanel>
        <StackPanel Visibility="{Binding HasKeyInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Fingerprint], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=FingerprintTextBox}" />
            <TextBox x:Name="FingerprintTextBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas">
                <TextBox.Text>
                    <MultiBinding Mode="OneWay" StringFormat="{}{0} ({1})">
                        <Binding Path="KeyInfo.Fingerprint" />
                        <Binding Path="KeyInfo.KeyType" />
                    </MultiBinding>
                </TextBox.Text>
            </TextBox>
        </StackPanel>
        <StackPanel Visibility="{Binding HasPrivateKey, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="0,12,0,6" Text="{Binding [PrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <ToggleButton x:Name="RevealPrivateKey" Margin="4,0,0,0" Padding="6,4"
                                  AutomationProperties.Name="{Binding [ShowHidePrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHidePrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RevealGlyph}" />
                    </ToggleButton>
                    <Button Margin="4,0,0,0" Padding="6,4"
                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                            CommandParameter="{Binding PrivateKey}"
                            AutomationProperties.Name="{Binding [CopyPrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                    </Button>
                    <Button Margin="4,0,0,0" Padding="6,4" Click="SavePrivateKey_Click"
                            AutomationProperties.Name="{Binding [SavePrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [SavePrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74E;" />
                    </Button>
                </StackPanel>
                <Grid>
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{Binding [PrivateKey], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                             Text="{Binding PrivateKey, Mode=OneWay}"
                             Visibility="{Binding IsChecked, ElementName=RevealPrivateKey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             Text="&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;"
                             Visibility="{Binding IsChecked, ElementName=RevealPrivateKey, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding [SshKeyEncrypted], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                       Visibility="{Binding IsEncrypted, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <StackPanel Visibility="{Binding HasPassphrase, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="0,12,0,6" Text="{Binding [Passphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="RevealPassphrase" Margin="4,0,0,0" Padding="6,4"
                                  AutomationProperties.Name="{Binding [ShowHidePassphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [ShowHidePassphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource RevealGlyph}" />
                    </ToggleButton>
                    <Button Margin="4,0,0,0" Padding="6,4"
                            Command="{Binding DataContext.CopyToClipboardCommand, RelativeSource={RelativeSource AncestorType=ctl:CredentialsDetailsControl}}"
                            CommandParameter="{Binding Passphrase}"
                            AutomationProperties.Name="{Binding [CopyPassphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [CopyPassphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8C8;" />
                    </Button>
                </StackPanel>
                <Grid>
                    <TextBox IsReadOnly="True" AutomationProperties.Name="{Binding [Passphrase], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             Text="{Binding Passphrase, Mode=OneWay}"
                             Visibility="{Binding IsChecked, ElementName=RevealPassphrase, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                             FontFamily="{StaticResource PasswordFontFamily}" FontSize="{StaticResource PasswordFontSize}"
                             Text="&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;&#x25CF;"
                             Visibility="{Binding IsChecked, ElementName=RevealPassphrase, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
        </StackPanel>
    </StackPanel>
</UserControl>

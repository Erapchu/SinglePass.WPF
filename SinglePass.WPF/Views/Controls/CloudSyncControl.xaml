<UserControl
    x:Class="SinglePass.WPF.Views.Controls.CloudSyncControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cloud="clr-namespace:SinglePass.WPF.Cloud.Enums"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    d:DataContext="{x:Static vm:CloudSyncViewModel.DesignTimeInstance}"
    mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource WorkspacePanelStyle}">
            <StackPanel>
                <TextBlock Margin="0,0,0,12" FontSize="16" FontWeight="SemiBold" Text="Google Drive" />
                <Button
                    HorizontalAlignment="Left"
                    Command="{Binding LoginCommand}"
                    CommandParameter="{x:Static cloud:CloudType.GoogleDrive}"
                    Content="{x:Static properties:Resources.SignIn}"
                    Style="{StaticResource WorkspacePrimaryButtonStyle}"
                    Visibility="{Binding GoogleDriveEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <StackPanel Visibility="{Binding GoogleDriveEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock
                        Text="{x:Static properties:Resources.Loading}"
                        Visibility="{Binding FetchingUserInfo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel
                        Margin="0,0,0,12"
                        Orientation="Horizontal"
                        Visibility="{Binding FetchingUserInfo, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Ellipse Width="36" Height="36">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding GoogleProfileImage}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding GoogleUserName}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <WrapPanel>
                        <Button
                            Margin="0,0,8,4"
                            Command="{Binding SyncCredentialsCommand}"
                            CommandParameter="{x:Static cloud:CloudType.GoogleDrive}"
                            Content="{x:Static properties:Resources.Sync}" />
                        <Button
                            Margin="0,0,8,4"
                            Command="{Binding UploadCredentialsCommand}"
                            CommandParameter="{x:Static cloud:CloudType.GoogleDrive}"
                            Content="{x:Static properties:Resources.Upload}" />
                        <Button
                            Margin="0,0,0,4"
                            Command="{Binding LogoutCommand}"
                            CommandParameter="{x:Static cloud:CloudType.GoogleDrive}"
                            Content="{x:Static properties:Resources.SignOut}" />
                    </WrapPanel>
                    <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="True">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MergeProcessing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UploadProcessing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>

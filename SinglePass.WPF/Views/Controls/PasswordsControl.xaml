<UserControl
    x:Class="SinglePass.WPF.Views.Controls.PasswordsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ct="clr-namespace:SinglePass.WPF.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:SinglePass.WPF.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:loc="clr-namespace:SinglePass.WPF.Localization"
    xmlns:settings="clr-namespace:SinglePass.WPF.Settings"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    d:DataContext="{x:Static vm:PasswordsViewModel.DesignTimeInstance}"
    IsVisibleChanged="UserControl_IsVisibleChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <ContextMenu x:Key="PasswordItemContextMenu">
            <MenuItem Command="{Binding Data.EditCommand, Source={StaticResource Proxy}}" Header="{Binding [Edit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <MenuItem Command="{Binding Data.DeleteCommand, Source={StaticResource Proxy}}" Header="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        </ContextMenu>
        <Style x:Key="CredentialListViewItem" BasedOn="{StaticResource {x:Static GridView.GridViewItemContainerStyleKey}}" TargetType="ListViewItem">
            <Setter Property="ContextMenu" Value="{StaticResource PasswordItemContextMenu}" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding Data.PasswordListPaneWidth, Source={StaticResource Proxy}, Mode=TwoWay}" MinWidth="190" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="{Binding Data.DetailsPaneWidth, Source={StaticResource Proxy}, Mode=TwoWay}" MinWidth="225" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchTextBox"
                    AutomationProperties.Name="{Binding [Search], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewKeyDown">
                            <i:InvokeCommandAction Command="{Binding HandleSearchKeyCommand}" PassEventArgsToCommand="True" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <TextBlock
                    Margin="{Binding Padding, ElementName=SearchTextBox}"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextControlPlaceholderForeground}"
                    IsHitTestVisible="False"
                    Text="{Binding [Search], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{Binding [NewItem], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                    Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE710;" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding [NewItem], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </StackPanel>
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="0,8">
                <ListView
                    x:Name="CredentialsListBox"
                    ItemContainerStyle="{StaticResource CredentialListViewItem}"
                    ItemsSource="{Binding DisplayedCredentials}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    SelectedItem="{Binding SelectedCredentialVM, UpdateSourceTrigger=PropertyChanged}"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="{Binding Data.ColumnWidths.Name, Source={StaticResource Proxy}, Mode=TwoWay}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Padding="8,0" Command="{Binding SortByCommand}" CommandParameter="{x:Static settings:SortType.Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding [Name], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                            <TextBlock Margin="4,0,0,0" Text="{Binding NameSortIndicator}" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <Image Width="16" Height="16" Margin="0,0,6,0"
                                                   Source="{Binding FavIcon, TargetNullValue={StaticResource DefaultFavIcon}}" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding NameFieldVM.Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding NameFieldVM.Value}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="{Binding Data.ColumnWidths.Website, Source={StaticResource Proxy}, Mode=TwoWay}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Padding="8,0" Command="{Binding SortByCommand}" CommandParameter="{x:Static settings:SortType.Website}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding [Website], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                            <TextBlock Margin="4,0,0,0" Text="{Binding WebsiteSortIndicator}" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding SiteFieldVM.Value}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding SiteFieldVM.Value, TargetNullValue=—}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SiteFieldVM.Value}" Value="">
                                                            <Setter Property="Text" Value="—" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="{Binding Data.ColumnWidths.Modified, Source={StaticResource Proxy}, Mode=TwoWay}">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Padding="8,0" Command="{Binding SortByCommand}" CommandParameter="{x:Static settings:SortType.Modified}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding [Modified], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                            <TextBlock Margin="4,0,0,0" Text="{Binding ModifiedSortIndicator}" />
                                        </StackPanel>
                                    </GridViewColumnHeader>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastModifiedTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding [NoCredentials], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayedCredentials.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <GridSplitter
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            ResizeBehavior="PreviousAndNext" />
        <ct:CredentialsDetailsControl x:Name="CredentialsDetailsControl" Grid.Column="2" />
    </Grid>
</UserControl>

<Window
    x:Class="SinglePass.WPF.Views.Windows.MessageDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels.Dialogs"
    xmlns:helpers="clr-namespace:SinglePass.WPF.Helpers"
    Title="{x:Static helpers:Constants.AppName}"
    Width="420"
    MaxHeight="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Closed="Window_Closed"
    d:DataContext="{x:Static vm:MessageDialogViewModel.DesignTimeInstance}"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <TextBlock
                Margin="0,0,10,0"
                Style="{StaticResource SymbolText}"
                Text="{Binding Glyph}"
                Visibility="{Binding IconVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Header}" TextWrapping="Wrap" />
        </DockPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                Command="{Binding Button1ActionCommand}"
                Content="{Binding Button1Text}"
                IsDefault="True" />
            <Button
                Margin="8,0,0,0"
                Command="{Binding Button2ActionCommand}"
                Content="{Binding Button2Text}"
                IsCancel="{Binding Button2IsCancel}"
                Visibility="{Binding Button2Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button
                Margin="8,0,0,0"
                Command="{Binding Button3ActionCommand}"
                Content="{Binding Button3Text}"
                IsCancel="{Binding Button3IsCancel}"
                Visibility="{Binding Button3Visible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</Window>

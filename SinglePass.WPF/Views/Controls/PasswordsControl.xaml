<UserControl
    x:Class="SinglePass.WPF.Views.Controls.PasswordsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:SinglePass.WPF.Converters"
    xmlns:ct="clr-namespace:SinglePass.WPF.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:SinglePass.WPF.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language"
    xmlns:settings="clr-namespace:SinglePass.WPF.Settings"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    d:DataContext="{x:Static vm:PasswordsViewModel.DesignTimeInstance}"
    IsVisibleChanged="UserControl_IsVisibleChanged"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <ContextMenu x:Key="PasswordItemContextMenu">
            <MenuItem Command="{Binding Data.EditCommand, Source={StaticResource Proxy}}" Header="{x:Static properties:Resources.Edit}" />
            <MenuItem Command="{Binding Data.DeleteCommand, Source={StaticResource Proxy}}" Header="{x:Static properties:Resources.Delete}" />
        </ContextMenu>
        <Style x:Key="CredentialListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
            <Setter Property="ContextMenu" Value="{StaticResource PasswordItemContextMenu}" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <DataTemplate x:Key="CredentialDataTemplate" DataType="{x:Type vm:CredentialViewModel}">
            <DockPanel>
                <Image Width="16" Height="16" VerticalAlignment="Center" Source="{Binding FavIcon}" />
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding NameFieldVM.Value}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="190" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="225" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Padding="0,0,0,6" Content="{x:Static properties:Resources.Search}" Target="{Binding ElementName=SearchTextBox}" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="PreviewKeyDown">
                            <i:InvokeCommandAction Command="{Binding HandleSearchKeyCommand}" PassEventArgsToCommand="True" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TextBox>
                <ToggleButton
                    x:Name="SortButton"
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    Padding="6,4"
                    ToolTip="{x:Static properties:Resources.SortBy}"
                    AutomationProperties.Name="{x:Static properties:Resources.SortBy}">
                    <TextBlock Style="{StaticResource SymbolText}" Text="&#xE8CB;" />
                </ToggleButton>
                <Popup
                    x:Name="SortPopup"
                    Opened="SortPopup_Opened"
                    DataContext="{Binding Data, Source={StaticResource Proxy}}"
                    IsOpen="{Binding IsChecked, ElementName=SortButton, Mode=TwoWay}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SortButton}"
                    StaysOpen="False">
                    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Style="{StaticResource Card}">
                        <StackPanel KeyboardNavigation.TabNavigation="Cycle" PreviewKeyDown="SortPopup_PreviewKeyDown">
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="{x:Static properties:Resources.SortBy}" />
                            <RadioButton x:Name="SortByName" Content="{x:Static properties:Resources.Name}" GroupName="Sort"
                                IsChecked="{Binding Sort, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static settings:SortType.Name}}" />
                            <RadioButton Content="{x:Static properties:Resources.Modified}" GroupName="Sort"
                                IsChecked="{Binding Sort, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static settings:SortType.Modified}}" />
                            <RadioButton Content="{x:Static properties:Resources.Created}" GroupName="Sort"
                                IsChecked="{Binding Sort, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static settings:SortType.Created}}" />
                            <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{x:Static properties:Resources.OrderBy}" />
                            <RadioButton Content="{x:Static properties:Resources.Ascending}" GroupName="Order"
                                IsChecked="{Binding Order, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static settings:OrderType.Ascending}}" />
                            <RadioButton Content="{x:Static properties:Resources.Descending}" GroupName="Order"
                                IsChecked="{Binding Order, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static settings:OrderType.Descending}}" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <Grid Grid.Row="2" Margin="0,8">
                <ListView
                    x:Name="CredentialsListBox"
                    ItemContainerStyle="{StaticResource CredentialListViewItem}"
                    ItemTemplate="{StaticResource CredentialDataTemplate}"
                    ItemsSource="{Binding DisplayedCredentials}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedCredentialVM, UpdateSourceTrigger=PropertyChanged}"
                    VirtualizingPanel.VirtualizationMode="Recycling" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static properties:Resources.NoCredentials}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DisplayedCredentials.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Button
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                Command="{Binding AddCommand}"
                Content="{x:Static properties:Resources.NewItem}"
                Style="{DynamicResource AccentButtonStyle}" />
        </Grid>
        <Border Grid.Column="1" Width="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <GridSplitter
            Grid.Column="1"
            Width="8"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            ResizeBehavior="PreviousAndNext" />
        <ct:CredentialsDetailsControl x:Name="CredentialsDetailsControl" Grid.Column="2" />
    </Grid>
</UserControl>

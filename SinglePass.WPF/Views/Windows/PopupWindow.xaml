<Window
    x:Class="SinglePass.WPF.Views.Windows.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:SinglePass.WPF.Helpers"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:SinglePass.Language.Properties;assembly=SinglePass.Language"
    xmlns:vm="clr-namespace:SinglePass.WPF.ViewModels"
    Title="{x:Static helpers:Constants.AppName}"
    Width="260"
    Height="300"
    d:DataContext="{x:Static vm:PopupViewModel.DesignTimeInstance}"
    Closed="Window_Closed"
    Closing="Window_Closing"
    Deactivated="Window_Deactivated"
    Loaded="Window_Loaded"
    PreviewKeyDown="Window_PreviewKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    UseLayoutRounding="True"
    WindowStyle="ToolWindow"
    mc:Ignorable="d">
    <Window.Resources>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <DataTemplate x:Key="CredentialDataTemplate" DataType="{x:Type vm:CredentialViewModel}">
            <DockPanel>
                <Image Width="16" Height="16" VerticalAlignment="Center"
                       Source="{Binding FavIcon, TargetNullValue={StaticResource DefaultFavIcon}}" />
                <StackPanel
                    DockPanel.Dock="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListViewItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button
                        Margin="4,0,0,0"
                        Padding="4"
                        Command="{Binding Data.SetAndCloseCommand, Source={StaticResource Proxy}}"
                        CommandParameter="{Binding LoginFieldVM}"
                        AutomationProperties.Name="{x:Static properties:Resources.Login}"
                        ToolTip="{x:Static properties:Resources.Login}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE77B;" />
                    </Button>
                    <Button
                        Margin="4,0,0,0"
                        Padding="4"
                        Command="{Binding Data.SetAndCloseCommand, Source={StaticResource Proxy}}"
                        CommandParameter="{Binding PasswordFieldVM}"
                        AutomationProperties.Name="{x:Static properties:Resources.Password}"
                        ToolTip="{x:Static properties:Resources.Password}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE72E;" />
                    </Button>
                </StackPanel>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding NameFieldVM.Value}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding NameFieldVM.Value}" />
            </DockPanel>
        </DataTemplate>
        <Style x:Key="CredentialPopupItemStyle" BasedOn="{StaticResource {x:Type ListViewItem}}" TargetType="ListViewItem">
            <Setter Property="Padding" Value="12,0,6,0" />
            <Setter Property="MinHeight" Value="38" />
        </Style>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Padding="0,0,0,6" Content="{x:Static properties:Resources.Search}" Target="{Binding ElementName=SearchTextBox}" />
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="6,4" Click="ClearSearch_Click"
                    AutomationProperties.Name="{x:Static properties:Resources.ClearSearch}" ToolTip="{x:Static properties:Resources.ClearSearch}">
                <TextBlock Style="{StaticResource SymbolText}" Text="&#xE711;" />
            </Button>
            <TextBox x:Name="SearchTextBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="PreviewKeyDown">
                        <i:InvokeCommandAction Command="{Binding HandleSearchKeyCommand}" PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </TextBox>
        </DockPanel>
        <ListView
            x:Name="CredListBox"
            Grid.Row="2"
            ItemContainerStyle="{StaticResource CredentialPopupItemStyle}"
            ItemTemplate="{StaticResource CredentialDataTemplate}"
            ItemsSource="{Binding DisplayedCredentials}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            SelectedItem="{Binding SelectedCredentialVM}"
            VirtualizingPanel.VirtualizationMode="Recycling" />
        <ProgressBar
            Grid.Row="2"
            Height="4"
            VerticalAlignment="Top"
            IsIndeterminate="True"
            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Window>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Erapkey.Converters">
    <!-- Shared by the views and editors of entry types. They are created before they are placed
         in the details card, so they cannot use the card's resources. -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
    <conv:BooleanTFConverter x:Key="InverseBooleanConverter" TrueValue="False" FalseValue="True" />

    <!-- Eye icon of a show/hide toggle; follows IsChecked of the toggle it is in. -->
    <Style x:Key="RevealGlyph" TargetType="TextBlock" BasedOn="{StaticResource SymbolText}">
        <Setter Property="Text" Value="&#xE890;" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Text" Value="&#xED1A;" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Status line that hides itself while empty. -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>

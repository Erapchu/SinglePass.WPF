<UserControl
    x:Class="SinglePass.WPF.Views.Controls.SyncPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:SinglePass.Core.Localization;assembly=SinglePass.Core">
    <Grid Margin="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Margin="16,16,16,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Margin="0,0,0,12" Style="{StaticResource ModalHeader}"
                           Text="{Binding [InputPasswordOfFile], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <Label Padding="0,0,0,6" Target="{Binding ElementName=PasswordInput}"
                       Content="{Binding [Password], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <PasswordBox x:Name="PasswordInput" FontFamily="{StaticResource PasswordFontFamily}"
                             FontSize="{StaticResource PasswordFontSize}" PasswordChanged="PasswordInput_Changed" />
            </StackPanel>
        </ScrollViewer>
        <ContentControl x:Name="Footer" Grid.Row="1" Style="{StaticResource ModalFooter}">
            <UniformGrid Rows="1" Columns="2">
                <Button x:Name="AcceptButton" Margin="5,0" Padding="6,4" MinHeight="36" HorizontalAlignment="Stretch"
                        Click="Accept_Click" IsDefault="True" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}"
                        Content="{Binding [OK], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                <Button Margin="5,0" Padding="6,4" MinHeight="36" HorizontalAlignment="Stretch" Click="Cancel_Click"
                        Content="{Binding [Cancel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            </UniformGrid>
        </ContentControl>
    </Grid>
</UserControl>

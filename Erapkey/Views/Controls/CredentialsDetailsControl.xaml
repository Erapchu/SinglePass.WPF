<UserControl
    x:Class="Erapkey.Views.Controls.CredentialsDetailsControl"
    x:Name="Details"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Erapkey.Converters"
    xmlns:entries="clr-namespace:Erapkey.Views.Controls.Entries"
    xmlns:evm="clr-namespace:Erapkey.ViewModels.Entries"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core">
    <!-- The fields every entry has (name, notes, additional fields, group, dates). The fields of the
         entry type come from the view or editor of its type, chosen by the DataTemplates below. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
        <conv:BooleanTFConverter x:Key="InverseBooleanConverter" TrueValue="False" FalseValue="True" />
        <DataTemplate x:Key="GroupOptionTemplate">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Margin="0,0,6,0" FontSize="14"
                           Style="{StaticResource SymbolText}" Text="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Name}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                    <Setter Property="Text" Value="{Binding [NoPasswordGroup], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Border x:Name="CardBorder" Padding="0">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Card}">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding SelectedCredentialVM}" Value="{x:Null}" />
                            <Condition Binding="{Binding IsEditing, ElementName=Details}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Visibility" Value="Collapsed" />
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="16,16,16,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <Button x:Name="EditButton" Margin="4,0" Padding="6,4" Click="EditButton_Click"
                            IsEnabled="{Binding CanEditCredential}"
                            AutomationProperties.Name="{Binding [Edit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [Edit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE70F;" />
                    </Button>
                    <Button x:Name="DeleteButton" Padding="6,4" Click="DeleteButton_Click" IsEnabled="{Binding CanEditCredential}"
                            AutomationProperties.Name="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" ToolTip="{Binding [Delete], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}">
                        <TextBlock Style="{StaticResource SymbolText}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
                <!-- Icon of the shown entry, chosen by its type: entry types with a glyph show it (cards show the
                     badge of their payment network); logins have no glyph and show the site icon below instead. -->
                <ContentControl x:Name="HeaderGlyph" DockPanel.Dock="Left" MinWidth="32" Margin="0,0,8,0"
                                VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                Focusable="False" IsTabStop="False">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type evm:CredentialDataViewModel}">
                            <TextBlock Style="{StaticResource SymbolText}" FontSize="24" Text="{Binding Glyph}" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type evm:CardViewModel}">
                            <entries:CardBrandIcon Brand="{Binding Brand}" ToolTip="{Binding BrandName}"
                                                   AutomationProperties.Name="{Binding BrandName}" />
                        </DataTemplate>
                    </ContentControl.Resources>
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="Content" Value="{Binding SelectedCredentialVM.Data}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditing, ElementName=Details}" Value="True">
                                    <Setter Property="Content" Value="{Binding DisplayedDraft.Data, ElementName=Details}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content.Glyph, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <Image x:Name="CredentialIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,8,0"
                       IsVisibleChanged="CredentialIcon_IsVisibleChanged">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{Binding SelectedCredentialVM.FavIcon, TargetNullValue={StaticResource DefaultFavIcon}}" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsAdding}" Value="True" />
                                        <Condition Binding="{Binding IsEditing, ElementName=Details}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Source" Value="{StaticResource DefaultFavIcon}" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding Visibility, ElementName=HeaderGlyph}" Value="Visible">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="{Binding SelectedCredentialVM.NameFieldVM.Value}"
                           Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <TextBox x:Name="NameEditBox" MaxLength="200" MinHeight="32" VerticalAlignment="Center"
                         AutomationProperties.Name="{Binding [Name], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}"
                         Text="{Binding DisplayedDraft.NameFieldVM.Value, ElementName=Details, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=False}"
                         IsVisibleChanged="NameEditBox_IsVisibleChanged"
                         IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBooleanConverter}}"
                         Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" Margin="16,0,16,16" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel Margin="0,0,4,0">
                    <ContentControl Content="{Binding SelectedCredentialVM.Data}" Focusable="False" IsTabStop="False">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type evm:LoginViewModel}">
                                <entries:LoginDetailsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type evm:SshKeyViewModel}">
                                <entries:SshKeyDetailsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type evm:CardViewModel}">
                                <entries:CardDetailsView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type evm:HostViewModel}">
                                <entries:HostDetailsView />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                    <StackPanel Visibility="{Binding SelectedCredentialVM.OtherFieldVM.HasText, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Other], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=OtherTextBox}" />
                        <TextBox x:Name="OtherTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                 Text="{Binding SelectedCredentialVM.OtherFieldVM.Value, Mode=OneWay}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding SelectedCredentialVM.AdditionalFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <Label Padding="0,0,0,6" Content="{Binding Name}" Target="{Binding ElementName=FieldValue}" />
                                    <TextBox x:Name="FieldValue" IsReadOnly="True" Text="{Binding Value, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Label DockPanel.Dock="Left" Padding="0,0,8,0" VerticalAlignment="Center"
                               Content="{Binding [PasswordGroupLabel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <ContentControl Content="{Binding CurrentGroup}" ContentTemplate="{StaticResource GroupOptionTemplate}"
                                        VerticalAlignment="Center" Focusable="False" />
                    </DockPanel>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Mode="OneWay">
                                <MultiBinding.Converter>
                                    <conv:LocalizedFormatConverter />
                                </MultiBinding.Converter>
                                <Binding Path="[ModifiedFormatted]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                <Binding Path="SelectedCredentialVM.LastModifiedTime" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding Mode="OneWay">
                                <MultiBinding.Converter>
                                    <conv:LocalizedFormatConverter />
                                </MultiBinding.Converter>
                                <Binding Path="[CreatedFormatted]" Source="{x:Static loc:LocalizationManager.Instance}" />
                                <Binding Path="SelectedCredentialVM.CreationTime" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="EditScrollViewer" Grid.Row="1" Margin="16,0,16,12" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          IsEnabled="{Binding IsSavingEdit, Converter={StaticResource InverseBooleanConverter}}"
                          Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Margin="0,0,4,0">
                    <ContentControl Content="{Binding DisplayedDraft.Data, ElementName=Details}" Focusable="False" IsTabStop="False">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type evm:LoginViewModel}">
                                <entries:LoginEditor />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type evm:SshKeyViewModel}">
                                <entries:SshKeyEditor />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type evm:CardViewModel}">
                                <entries:CardEditor />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type evm:HostViewModel}">
                                <entries:HostEditor />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                    <Label Margin="0,12,0,0" Padding="0,0,0,6" Content="{Binding [Other], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" Target="{Binding ElementName=OtherEditBox}" />
                    <TextBox x:Name="OtherEditBox" AcceptsReturn="True" MaxLength="5000" TextWrapping="Wrap"
                             Text="{Binding DisplayedDraft.OtherFieldVM.Value, ElementName=Details, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl ItemsSource="{Binding DisplayedDraft.AdditionalFields, ElementName=Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <Label Padding="0,0,0,6" Content="{Binding Name}" Target="{Binding ElementName=FieldEditBox}" />
                                    <TextBox x:Name="FieldEditBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,0" HorizontalAlignment="Left">
                        <Label DockPanel.Dock="Left" Padding="0,0,8,0" VerticalAlignment="Center"
                               Target="{Binding ElementName=GroupSelector}"
                               Content="{Binding [PasswordGroupLabel], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <ComboBox x:Name="GroupSelector" MinWidth="110" MaxWidth="220"
                                  ItemsSource="{Binding GroupOptions}"
                                  ItemTemplate="{StaticResource GroupOptionTemplate}"
                                  SelectedItem="{Binding DraftGroup, Mode=TwoWay}" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
            <Grid x:Name="EditorFooter" Grid.Row="2"
                  Visibility="{Binding IsEditing, ElementName=Details, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" CornerRadius="0,0,7,7"
                        IsHitTestVisible="False" />
                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                        Padding="25,20">
                    <UniformGrid Rows="1" Columns="2">
                        <Button Margin="0,0,5,0" MinHeight="36" HorizontalAlignment="Stretch"
                                Command="{Binding SaveEditCommand}" Style="{DynamicResource AccentButtonStyle}"
                                Content="{Binding [Save], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                        <Button Margin="5,0,0,0" MinHeight="36" HorizontalAlignment="Stretch"
                                Command="{Binding CancelEditCommand}"
                                Content="{Binding [CancelEdit], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
                    </UniformGrid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>

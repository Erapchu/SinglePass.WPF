<Window
    x:Class="Erapkey.Views.Windows.BrowserPairingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Erapkey.Core.Localization;assembly=Erapkey.Core"
    xmlns:coreHelpers="clr-namespace:Erapkey.Core.Helpers;assembly=Erapkey.Core"
    Title="{x:Static coreHelpers:Constants.DisplayName}"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    Topmost="True"
    ShowInTaskbar="True"
    WindowStartupLocation="CenterScreen">
    <!-- Asks whether a browser extension may connect. Opened by BrowserBackend. -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="20" Style="{StaticResource SymbolText}" Text="&#xE774;" />
            <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="{Binding [BrowserPairingHeader], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        </DockPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding [BrowserPairingBrowser], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <TextBlock x:Name="BrowserName" Margin="0,2,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding [BrowserPairingCode], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <TextBlock x:Name="Code" Margin="0,2,0,0" FontSize="28" FontWeight="SemiBold" FontFamily="Consolas" />
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="{Binding [BrowserPairingHint], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        <UniformGrid Grid.Row="4" Margin="0,20,0,0" Rows="1" Columns="2">
            <Button Margin="0,0,5,0" MinHeight="32" HorizontalAlignment="Stretch" Click="Allow_Click"
                    Style="{DynamicResource AccentButtonStyle}"
                    Content="{Binding [BrowserPairingAllow], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
            <Button Margin="5,0,0,0" MinHeight="32" HorizontalAlignment="Stretch" IsCancel="True" IsDefault="True" Click="Deny_Click"
                    Content="{Binding [SshAgentDeny], Source={x:Static loc:LocalizationManager.Instance}, Mode=OneWay}" />
        </UniformGrid>
    </Grid>
</Window>
